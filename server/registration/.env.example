# Copy to .env on the server (next to docker-compose.yml) and set real values.
ADMIN_USER=tsae
ADMIN_PASS=change-this-to-a-strong-secret
# Used to sign the admin session cookie. Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-hex-string

# SMTP — GoDaddy Workspace Email (tsae.asia DNS: secureserver.net)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
# Port 465 (SSL) also works: set SMTP_PORT=465
SMTP_USER=center@tsae.asia
SMTP_PASS=your-email-password-here
SMTP_FROM=center@tsae.asia
NOTIFY_EMAIL=center@tsae.asia
SITE_URL=https://www.tsae.asia
