---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, useTranslations, localize, formatDate } from '../../i18n/utils';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';

const displayTitle = localize(lang, event.data.title, event.data.titleTH);
const displayExcerpt = localize(lang, event.data.excerpt, event.data.excerptTH);
const displayLocation = localize(lang, event.data.location, event.data.locationTH);

const typeColor: Record<string, string> = {
  national: '#1a6b3a', international: '#1e40af', training: '#c8a951', webinar: '#7c3aed',
};
const statusColor: Record<string, string> = {
  upcoming: '#16a34a', ongoing: '#d97706', past: '#6b7280',
};

const typeLabel = t(`type.${event.data.type}` as any) || event.data.type;
const statusLabel = t(`status.${event.data.status}` as any) || event.data.status;

const fmtDate = (d: Date) => formatDate(lang, d, { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
---

<Layout title={displayTitle} description={displayExcerpt} lang={lang}>
  <div class="py-12" style="background: linear-gradient(135deg, #0d3b1e, #1a6b3a);">
    <div class="max-w-7xl mx-auto px-4">
      <nav class="flex items-center gap-2 text-sm text-green-300 mb-4 flex-wrap">
        <a href={`${base}/`} class="hover:text-white transition-colors">{t('ui.home')}</a>
        <span>/</span>
        <a href={`${base}/events`} class="hover:text-white transition-colors">{t('nav.events')}</a>
        <span>/</span>
        <span class="text-white">{displayTitle}</span>
      </nav>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <article class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <span class="px-3 py-1 rounded-full text-sm font-semibold text-white" style={`background-color: ${typeColor[event.data.type] || '#6b7280'};`}>{typeLabel}</span>
          <span class="px-3 py-1 rounded-full text-sm font-semibold text-white" style={`background-color: ${statusColor[event.data.status] || '#6b7280'};`}>{statusLabel}</span>
        </div>

        <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 leading-tight mb-6">{displayTitle}</h1>

        {event.data.image && (
          <div class="mb-8 rounded-xl overflow-hidden">
            <img src={event.data.image} alt={displayTitle} class="w-full h-72 object-cover" onerror="this.parentElement.style.display='none'" />
          </div>
        )}

        <div class="p-5 rounded-xl border-l-4 mb-8" style="background-color: #f0faf4; border-color: #1a6b3a;">
          <p class="text-gray-700 font-medium leading-relaxed">{displayExcerpt}</p>
        </div>

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </article>

      <aside class="lg:col-span-1">
        <a href={`${base}/events`} class="flex items-center gap-2 text-sm font-medium mb-6 transition-colors" style="color: #1a6b3a;" onmouseover="this.style.color='#c8a951'" onmouseout="this.style.color='#1a6b3a'">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          {t('events.back')}
        </a>

        <div class="bg-white rounded-xl shadow-md overflow-hidden mb-6">
          <div class="p-1" style="background: linear-gradient(135deg, #1a6b3a, #c8a951);"></div>
          <div class="p-5">
            <h3 class="font-bold text-gray-900 mb-4 text-sm uppercase tracking-wide">{t('events.infoTitle')}</h3>
            <div class="space-y-3 text-sm">
              <div class="flex gap-2">
                <span class="font-semibold text-gray-600 min-w-20">{t('events.dateLabel')}:</span>
                <span class="text-gray-800">
                  {fmtDate(event.data.startDate)}
                  {event.data.endDate && event.data.endDate.getTime() !== event.data.startDate.getTime() && (
                    <> – {fmtDate(event.data.endDate)}</>
                  )}
                </span>
              </div>
              {displayLocation && (
                <div class="flex gap-2">
                  <span class="font-semibold text-gray-600 min-w-20">{t('events.locationLabel')}:</span>
                  <span class="text-gray-800">{displayLocation}</span>
                </div>
              )}
              <div class="flex gap-2">
                <span class="font-semibold text-gray-600 min-w-20">{t('events.typeLabel')}:</span>
                <span class="text-gray-800">{typeLabel}</span>
              </div>
            </div>
          </div>
        </div>

        {event.data.registrationUrl && event.data.status !== 'past' && (
          <div class="mb-6">
            <h3 class="font-bold text-gray-900 mb-3 text-sm">{t('events.registerTitle')}</h3>
            <a
              href={event.data.registrationUrl}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 w-full py-3 text-white font-semibold rounded-xl text-sm transition-colors"
              style="background-color: #c8a951;"
              onmouseover="this.style.backgroundColor='#a8892f'"
              onmouseout="this.style.backgroundColor='#c8a951'"
            >
              {t('ui.register')}
            </a>
          </div>
        )}

        <div class="p-5 rounded-xl border border-gray-200 bg-gray-50">
          <h3 class="font-bold text-gray-900 mb-3 text-sm">{t('events.inquire')}</h3>
          <div class="space-y-2 text-sm text-gray-600">
            <p><a href="tel:0818072458" class="hover:text-green-700">081 807 2458</a></p>
            <p><a href="mailto:center@tsae.asia" class="hover:text-green-700">center@tsae.asia</a></p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .prose h2 { color: #1a6b3a; margin-top: 2rem; margin-bottom: 1rem; }
  .prose h3 { color: #124d2a; margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose ul { list-style-type: disc; padding-left: 1.5rem; }
  .prose ol { list-style-type: decimal; padding-left: 1.5rem; }
  .prose li { margin-bottom: 0.5rem; }
  .prose a { color: #1a6b3a; text-decoration: underline; }
  .prose blockquote { border-left: 4px solid #c8a951; padding-left: 1rem; color: #6b7280; }
  .prose strong { font-weight: 700; }
</style>
