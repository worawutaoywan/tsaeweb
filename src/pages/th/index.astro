---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ConferencesFeature from '../../components/ConferencesFeature.astro';
import VideoFeature from '../../components/VideoFeature.astro';
import HomeNewsFeature from '../../components/HomeNewsFeature.astro';
import HomeAbout from '../../components/HomeAbout.astro';
import HomeJournal from '../../components/HomeJournal.astro';
import HomeCta from '../../components/HomeCta.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { currentIssue } from '../../data/journalIssues';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const latestJournal = currentIssue;
---

<Layout title={t('ui.home')} description={t('site.tagline')} lang={lang}>
  <HeroSection lang={lang} />

  <ConferencesFeature lang={lang} />

  <VideoFeature lang={lang} />

  <HomeNewsFeature
    lang={lang}
    title={t('home.latestNews')}
    description={t('home.latestNewsDesc')}
    items={latestNews}
  />

  <HomeAbout
    lang={lang}
    badge={t('home.aboutBadge')}
    title={t('home.aboutTitle')}
    desc1={t('home.aboutDesc1')}
    desc2={t('home.aboutDesc2')}
  />

  {latestJournal && (
    <HomeJournal
      lang={lang}
      volume={latestJournal.volume}
      issue={latestJournal.issue}
      year={latestJournal.year}
      url={latestJournal.url}
    />
  )}

  <HomeCta
    lang={lang}
    title={t('home.ctaTitle')}
    description={t('home.ctaDesc')}
    buttonLabel={t('home.ctaJoin')}
  />
</Layout>
