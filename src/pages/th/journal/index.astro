---
import Layout from '../../../layouts/Layout.astro';
import JournalCard from '../../../components/JournalCard.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { journalIssues, currentIssue } from '../../../data/journalIssues';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';
const th = lang === 'th';

const current = currentIssue;
const recent = journalIssues.slice(0, 7);
---

<Layout title={t('journal.title')} description={t('journal.subtitle')} lang={lang}>
  <div class="py-12" style="background: linear-gradient(135deg, #0d3b1e, #1a6b3a);">
    <div class="max-w-7xl mx-auto px-4">
      <nav class="flex items-center gap-2 text-sm text-green-300 mb-4">
        <a href={`${base}/`} class="hover:text-white transition-colors">{t('ui.home')}</a>
        <span>/</span>
        <span class="text-white">{t('nav.journal')}</span>
      </nav>
      <h1 class="text-4xl font-bold text-white mb-2">{lang === 'th' ? 'วารสาร' : 'Journals'}</h1>
      <p class="text-green-100 text-sm">{t('journal.subtitle')}</p>
    </div>
  </div>

  <div class="border-b border-gray-200" style="background-color: #f8f9fa;">
    <div class="max-w-7xl mx-auto px-4 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-2">
          <h2 class="text-xl font-bold text-gray-900 mb-3">{t('journal.about')}</h2>
          <p class="text-gray-700 text-sm leading-relaxed mb-3">
            {lang === 'th'
              ? 'วารสาร สวกท. (TSAE Journal) เป็นวารสารวิชาการของสมาคมวิศวกรรมเกษตรแห่งประเทศไทย เผยแพร่บทความวิจัยและบทความวิชาการด้านวิศวกรรมเกษตร ชีววิศวกรรม และสาขาที่เกี่ยวข้อง'
              : 'The TSAE Journal is the academic journal of the Thai Society of Agricultural Engineering, publishing research and academic articles in agricultural engineering, bioengineering and related fields.'}
          </p>
          <p class="text-gray-700 text-sm leading-relaxed">
            {lang === 'th'
              ? 'ทุกบทความผ่านการพิจารณาจากผู้ทรงคุณวุฒิ (Peer Review) กำหนดออกปีละ 2 ฉบับ คือ ฉบับที่ 1 (มกราคม–มิถุนายน) และฉบับที่ 2 (กรกฎาคม–ธันวาคม)'
              : 'Every article is peer-reviewed. The journal is published twice a year: Issue 1 (January–June) and Issue 2 (July–December).'}
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a href="mailto:journal@tsae.asia" class="flex items-center gap-2 px-4 py-2.5 rounded-lg text-white text-sm font-semibold transition-colors" style="background-color: #1a6b3a;" onmouseover="this.style.backgroundColor='#124d2a'" onmouseout="this.style.backgroundColor='#1a6b3a'">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            {t('journal.submit')}
          </a>
          <a href={`${base}/contact`} class="flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors border-2" style="border-color: #c8a951; color: #c8a951;" onmouseover="this.style.backgroundColor='#c8a951'; this.style.color='white';" onmouseout="this.style.backgroundColor=''; this.style.color='#c8a951';">
            {t('journal.author')}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="mb-8 rounded-2xl overflow-hidden shadow-md" style="background: linear-gradient(135deg, #0d3b1e 0%, #1a6b3a 60%, #24824a 100%);">
      <div class="flex flex-col sm:flex-row items-center gap-4 p-5 sm:p-6">
        <div class="shrink-0 flex items-baseline gap-1.5 text-white">
          <span class="text-3xl sm:text-4xl font-extrabold leading-none">{current.volume}</span>
          <span class="text-base font-semibold text-green-100">/ {current.issue}</span>
        </div>
        <div class="flex-1 min-w-0 text-center sm:text-left">
          <div class="inline-block text-[10px] font-bold px-2.5 py-0.5 rounded-full mb-1" style="background:#e6cf8a; color:#0d3b1e;">{th ? 'ฉบับปัจจุบัน' : 'Current issue'}</div>
          <h2 class="text-lg sm:text-xl font-bold text-white">{th ? `วารสาร สวกท. ปีที่ ${current.volume} ฉบับที่ ${current.issue}` : `TSAE Journal Vol. ${current.volume} No. ${current.issue}`}</h2>
          <p class="text-green-100 text-xs mt-0.5">{th ? `พ.ศ. ${current.year + 543} (${current.year})` : current.year}</p>
        </div>
        <a href={current.url} target="_blank" rel="noopener" class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition-transform hover:scale-105" style="background:#e6cf8a; color:#0d3b1e;">
          {th ? 'อ่านฉบับปัจจุบัน' : 'Read current issue'}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>

    <div class="mb-6">
      <h2 class="text-2xl font-bold" style="color: #1a6b3a;">{t('journal.recent')}</h2>
      <p class="text-sm text-gray-500 mt-1">{t('journal.recentDesc')}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {recent.map((issue) => (
        <JournalCard lang={lang} issue={issue} />
      ))}

      <a href={`${base}/journal/archive`} class="group flex flex-col items-center justify-center text-center rounded-2xl border-2 border-dashed p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="border-color: #1a6b3a; background: linear-gradient(135deg, #f0faf4, #ffffff);">
        <div class="w-14 h-14 rounded-full flex items-center justify-center mb-3 text-white transition-transform group-hover:scale-110" style="background-color: #1a6b3a;">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 8h14M5 8a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v1a2 2 0 01-2 2M5 8l1 11a2 2 0 002 2h8a2 2 0 002-2l1-11M10 12h4"/></svg>
        </div>
        <h3 class="font-bold text-base mb-1" style="color: #1a6b3a;">{t('journal.archive')}</h3>
        <p class="text-xs text-gray-500 mb-3">{t('journal.archiveCardDesc')}</p>
        <span class="inline-flex items-center gap-1 text-xs px-4 py-2 rounded-lg text-white font-semibold" style="background-color: #1a6b3a;">
          {t('journal.viewAll')}
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>

    <div class="mt-14 p-8 rounded-2xl text-center border-2" style="border-color: #1a6b3a; background: linear-gradient(135deg, #f0faf4, #ffffff);">
      <h3 class="text-xl font-bold mb-3" style="color: #1a6b3a;">{t('journal.submitQ')}</h3>
      <p class="text-gray-600 mb-6 max-w-xl mx-auto">{t('journal.submitDesc')}</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href="mailto:journal@tsae.asia" class="px-6 py-3 text-white font-semibold rounded-xl transition-colors" style="background-color: #1a6b3a;" onmouseover="this.style.backgroundColor='#124d2a'" onmouseout="this.style.backgroundColor='#1a6b3a'">
          {t('journal.submit')}
        </a>
        <a href={`${base}/contact`} class="px-6 py-3 font-semibold rounded-xl border-2 transition-colors" style="border-color: #c8a951; color: #c8a951;" onmouseover="this.style.backgroundColor='#c8a951'; this.style.color='white';" onmouseout="this.style.backgroundColor=''; this.style.color='#c8a951';">
          {t('journal.inquiry')}
        </a>
      </div>
    </div>
  </div>
</Layout>
