---
import Layout from '../../../../layouts/Layout.astro';
import JournalCard from '../../../../components/JournalCard.astro';
import { getLangFromUrl, useTranslations } from '../../../../i18n/utils';
import { journalIssues, type JournalIssue } from '../../../../data/journalIssues';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';

const byYear: Record<number, JournalIssue[]> = {};
for (const j of journalIssues) {
  if (!byYear[j.year]) byYear[j.year] = [];
  byYear[j.year].push(j);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<Layout title={t('journal.archiveTitle')} description={t('journal.archiveSubtitle')} lang={lang}>
  <div class="py-12" style="background: linear-gradient(135deg, #0d3b1e, #1a6b3a);">
    <div class="max-w-7xl mx-auto px-4">
      <nav class="flex items-center gap-2 text-sm text-green-300 mb-4">
        <a href={`${base}/`} class="hover:text-white transition-colors">{t('ui.home')}</a>
        <span>/</span>
        <a href={`${base}/journal`} class="hover:text-white transition-colors">{t('nav.journal')}</a>
        <span>/</span>
        <span class="text-white">{t('journal.archive')}</span>
      </nav>
      <h1 class="text-4xl font-bold text-white mb-2">{t('journal.archiveTitle')}</h1>
      <p class="text-green-100 text-sm">{t('journal.archiveSubtitle')}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <a href={`${base}/journal`} class="inline-flex items-center gap-1.5 text-sm font-semibold mb-8 transition-colors" style="color: #1a6b3a;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      {t('journal.backToJournal')}
    </a>

    {years.map((year) => (
      <div class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="text-2xl font-bold" style="color: #1a6b3a;">
            {lang === 'th' ? `ปี ${year} (พ.ศ. ${year + 543})` : `Year ${year}`}
          </h2>
          <div class="flex-1 h-px bg-gray-200"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {byYear[year].map((issue) => (
            <JournalCard lang={lang} issue={issue} />
          ))}
        </div>
      </div>
    ))}
  </div>
</Layout>
