---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ConferencesFeature from '../components/ConferencesFeature.astro';
import VideoFeature from '../components/VideoFeature.astro';
import HomeNewsFeature from '../components/HomeNewsFeature.astro';
import HomeAbout from '../components/HomeAbout.astro';
import HomeJournal from '../components/HomeJournal.astro';
import HomeCta from '../components/HomeCta.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import homepage from '../../data/cms/homepage.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const th = lang === 'th';

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const home = homepage;
const homeText = (thai: string, english: string) => th ? thai : english;
const latestJournal = {
  volume: home.journalVolume,
  issue: home.journalIssue,
  year: home.journalYear,
  url: home.journalUrl,
};
---

<Layout title={t('ui.home')} description={t('site.tagline')} lang={lang}>
  <HeroSection lang={lang} />

  <ConferencesFeature lang={lang} />

  <VideoFeature lang={lang} />

  {home.latestNewsEnabled && (
    <HomeNewsFeature
      lang={lang}
      title={homeText(home.latestNewsTitleTH, home.latestNewsTitleEN)}
      description={homeText(home.latestNewsDescTH, home.latestNewsDescEN)}
      items={latestNews}
    />
  )}

  {home.aboutEnabled && (
    <HomeAbout
      lang={lang}
      badge={homeText(home.aboutBadgeTH, home.aboutBadgeEN)}
      title={homeText(home.aboutTitleTH, home.aboutTitleEN)}
      desc1={homeText(home.aboutDesc1TH, home.aboutDesc1EN)}
      desc2={homeText(home.aboutDesc2TH, home.aboutDesc2EN)}
    />
  )}

  {home.journalEnabled && latestJournal && (
    <HomeJournal
      lang={lang}
      volume={latestJournal.volume}
      issue={latestJournal.issue}
      year={latestJournal.year}
      url={latestJournal.url}
    />
  )}

  {home.ctaEnabled && (
    <HomeCta
      lang={lang}
      title={homeText(home.ctaTitleTH, home.ctaTitleEN)}
      description={homeText(home.ctaDescTH, home.ctaDescEN)}
      buttonLabel={homeText(home.ctaButtonTH, home.ctaButtonEN)}
    />
  )}
</Layout>
