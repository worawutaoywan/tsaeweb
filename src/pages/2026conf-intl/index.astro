        <div class="w-14 h-14 rounded-xl bg-white/10 flex items-center justify-center shrink-0 ring-1 ring-white/10">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div class="flex-1 text-center sm:text-left">
          <h3 class="font-semibold text-lg">TSAE 2026 Paper Template</h3>
          <p class="text-white/55 text-sm mt-1">Microsoft Word (.docx) · double-column · E3S style</p>
        </div>
        <a href={templateUrl} download class="intl-btn intl-btn-gold shrink-0">Download template</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {templateSpecs.map((s) => (
          <div class="bg-white rounded-xl ring-1 ring-slate-200/80 p-5">
