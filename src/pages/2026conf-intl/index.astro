// Organizing Committee — Thai Society of Agricultural Engineering
const committeeOrganizing = [
  'Dr. Dares Kittiyopas',
  'Mr. Pramote Klainetr',
  'Mr. Viboon Thepent',
  'Mr. Cherawat Munkit',
  'Dr. Wuttiphol Chansrakoo',
  'Ms. Chanyanuch Pan-iam',
