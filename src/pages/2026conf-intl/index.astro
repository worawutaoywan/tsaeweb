            <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 h-full">
              <div class="intl-speaker-photo shrink-0 w-full sm:w-40 lg:w-44 aspect-square rounded-xl overflow-hidden bg-slate-100 ring-1 ring-black/5">
