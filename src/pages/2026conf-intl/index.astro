        {importantDates.map((d, i) => (
          <li class={`flex items-center justify-between gap-6 py-5 border-b border-white/10 ${d.highlight ? 'bg-white/[0.04] -mx-4 px-4 rounded-lg border-b-0 ring-1 ring-[#c8a951]/35' : ''}`}>
