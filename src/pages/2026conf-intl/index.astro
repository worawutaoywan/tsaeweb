      </div>
      <p class="text-xs text-slate-400 text-center mt-6">Tip: submit both Word (.docx) and PDF versions.</p>
    </div>
  </section>

  <!-- PRESENTATION SPECIFICATIONS -->
  <section id="presentation" class="intl-section bg-white scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-10">
        <p class="intl-eyebrow mb-3">On site &amp; online</p>
        <h2 class="intl-h2">Presentation specifications</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
