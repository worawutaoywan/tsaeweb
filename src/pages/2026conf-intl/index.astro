            </div>
            <span class={`text-sm sm:text-base font-semibold whitespace-nowrap tabular-nums ${d.highlight ? 'text-[#e8d5a3]' : 'text-white'}`}>{d.date}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROGRAMME / SCHEDULE -->
  <section id="schedule" class="intl-section scroll-mt-24" style="background:#f4f6f4;">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="intl-eyebrow mb-3">7–10 September 2026</p>
        <h2 class="intl-h2">Conference programme</h2>
        <p class="text-slate-500 mt-3 text-sm leading-relaxed">
          Day 1 online · Days 2–4 on-site at Taipei Nangang Exhibition Center (TaiNEX 1), Hall 1
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href={programPdfUrl} target="_blank" rel="noopener" class="intl-btn intl-btn-gold inline-flex items-center gap-2">
            Download full programme (PDF)
          </a>
          <a href={programDocxUrl} target="_blank" rel="noopener" class="intl-btn intl-btn-outline inline-flex items-center gap-2">
            Word (.docx)
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-7">
          <div class="flex flex-wrap gap-2 mb-6" role="tablist" aria-label="Programme days" id="programme-tabs">
            {programme.map((d, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${d.id}`}
                aria-controls={`panel-${d.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-day={d.id}
                class={`intl-day-tab ${i === 0 ? 'is-active' : ''}`}
              >
                <span class="block text-[10px] uppercase tracking-[0.16em] opacity-70">{d.day}</span>
                <span class="block text-sm font-semibold mt-0.5">{d.date.replace(' 2026', '')}</span>
              </button>
            ))}
          </div>

          {programme.map((d, i) => (
            <div
              id={`panel-${d.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${d.id}`}
              data-panel={d.id}
              class={`intl-day-panel rounded-xl ring-1 ring-slate-200 bg-white overflow-hidden ${i === 0 ? '' : 'hidden'}`}
            >
              <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/80 flex flex-wrap items-center justify-between gap-2">
                <div>
                  <p class="font-semibold text-slate-900">{d.date}</p>
                  <p class="text-xs text-slate-500 mt-0.5">{d.venue}</p>
                </div>
                <span class={`text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-md ${d.mode === 'Online' ? 'bg-slate-100 text-slate-600' : 'bg-[#1a6b3a]/10 text-[#1a6b3a]'}`}>
                  {d.mode}
                </span>
              </div>
              <ol class="divide-y divide-slate-100">
                {d.items.map((item) => (
                  <li class={`flex gap-4 sm:gap-6 px-5 py-3.5 ${item.break ? 'bg-slate-50/60' : ''}`}>
                    <span class="shrink-0 w-[7.5rem] sm:w-36 text-xs sm:text-sm tabular-nums text-slate-400 font-medium pt-0.5">{item.time}</span>
                    <span class={`text-sm leading-snug ${item.break ? 'text-slate-500' : 'text-slate-800 font-medium'}`}>{item.title}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}

          <p class="text-xs text-slate-500 mt-5 leading-relaxed">
            Academic conference participants can enter the Taiwan Smart Agriweek exhibition for free.
            Download the PDF for session papers, Zoom details, and chair assignments.
          </p>
        </div>

        <div class="lg:col-span-5 space-y-6">
          <a href={programPdfUrl} target="_blank" rel="noopener" class="block rounded-xl ring-1 ring-[#1a6b3a]/25 bg-white p-6 shadow-sm hover:ring-[#1a6b3a]/40 transition group">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-[#1a6b3a] mb-2">Full programme · updated 4 Sep 2026</p>
            <p class="text-lg font-semibold text-slate-900 group-hover:text-[#1a6b3a] transition">19th TSAE International Conference Program</p>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">PDF · sessions, paper list, Zoom links, and session chairs</p>
            <span class="inline-flex mt-4 intl-btn intl-btn-outline text-sm">Download PDF</span>
          </a>
          <a href={scheduleUrl} target="_blank" rel="noopener" class="block group">
            <figure class="rounded-xl overflow-hidden ring-1 ring-slate-200 bg-white shadow-sm transition group-hover:ring-slate-300">
              <img
                src={scheduleUrl}
                alt="TSAE 2026 official conference schedule poster — 7–10 September 2026, Taipei"
                class="w-full h-auto"
                loading="lazy"
                width="724"
                height="1024"
              />
            </figure>
            <p class="mt-3 text-center text-xs text-slate-500 group-hover:text-[#1a6b3a] transition">
              Programme poster · click to enlarge
            </p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- REGISTRATION FEES -->
  <section id="fees" class="intl-section bg-white scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="intl-eyebrow mb-3">Participation</p>
        <h2 class="intl-h2">Registration fees</h2>
        <p class="text-slate-500 mt-3 text-sm">Early-bird rate valid until 31 July 2026</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        {[{title:'Online participation', rows:feesOnline}, {title:'Onsite participation', note:'Includes 3-night accommodation', rows:feesOnsite}].map((tb) => (
          <div class="rounded-xl overflow-hidden ring-1 ring-slate-200 bg-white">
            <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/80">
              <h3 class="font-semibold text-slate-900">{tb.title}</h3>
              {'note' in tb && tb.note && <p class="text-xs text-slate-500 mt-0.5">{tb.note}</p>}
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[440px]">
                <thead>
                  <tr class="text-left text-[11px] uppercase tracking-wider text-slate-400">
                    <th class="px-5 py-3 font-medium">Participant</th>
                    <th class="px-5 py-3 font-medium">Early bird</th>
                    <th class="px-5 py-3 font-medium">Regular</th>
                  </tr>
                </thead>
                <tbody>
                  {tb.rows.map((r) => (
                    <tr class="border-t border-slate-100">
                      <td class="px-5 py-3.5 font-medium text-slate-800 whitespace-nowrap">{r.who}</td>
                      <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap tabular-nums">{r.early}</td>
                      <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap tabular-nums">{r.regular}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-slate-500 mt-8 text-center max-w-3xl mx-auto leading-relaxed">
        Academic conference participants can enter the Taiwan Smart Agriweek exhibition for free. Participants who register under the non-member rate are eligible to apply for TSAE membership without any additional fee.
      </p>
    </div>
  </section>

  <!-- PAYMENT -->
  <section id="payment" class="intl-section scroll-mt-24" style="background:#f4f6f4;">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="intl-eyebrow mb-3">Bank transfer</p>
