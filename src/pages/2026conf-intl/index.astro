          { title: 'Poster', items: presentPoster },
        ].map((block) => (
          <div class="rounded-xl ring-1 ring-slate-200 overflow-hidden bg-white">
            <div class="px-5 py-3.5 border-b border-slate-100 bg-slate-50/80">
              <h3 class="font-semibold text-slate-900">{block.title}</h3>
            </div>
