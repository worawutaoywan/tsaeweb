  { name: 'Prof. Dr. Xiao Dong Chen', inst: 'Tsinghua Shenzhen International Graduate School, China' },
  { name: 'Prof. Dr. Anupun Terdwongworakul', inst: 'Kasetsart University, Thailand' },
  { name: 'Assoc. Prof. Dr. Areeya Rittima', inst: 'Mahidol University, Thailand' },
  { name: 'Prof. Dr. Panmanas Sirisomboon', inst: "King Mongkut's Institute of Technology Ladkrabang, Thailand" },
  { name: 'Assoc. Prof. Dr. Prathuang Usaborisut', inst: 'Kasetsart University, Thailand' },
  { name: 'Prof. Dr. Sakamon Devahastin', inst: "King Mongkut's University of Technology Thonburi, Thailand" },
