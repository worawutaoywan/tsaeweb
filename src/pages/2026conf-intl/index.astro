const feesOnline = [
  { who: 'Student / Observer', early: 'US$ 250 (8,750 THB)', regular: 'US$ 300 (10,500 THB)' },
  { who: 'TSAE Member', early: 'US$ 300 (10,500 THB)', regular: 'US$ 350 (12,250 THB)' },
  { who: 'Non-Member', early: 'US$ 375 (13,125 THB)', regular: 'US$ 425 (14,875 THB)' },
];
const feesOnsite = [
  { who: 'Student / Observer', early: 'US$ 600 (21,000 THB)', regular: 'US$ 650 (22,750 THB)' },
  { who: 'TSAE Member', early: 'US$ 650 (22,750 THB)', regular: 'US$ 700 (24,500 THB)' },
  { who: 'Non-Member', early: 'US$ 725 (25,375 THB)', regular: 'US$ 775 (27,125 THB)' },
];

const submitUrl = 'https://easychair.org/conferences/?conf=tsae2026';
const posterUrl = '/images/conf/intl-poster-1.jpg';
const posterUrl2 = '/images/conf/intl-poster-2.jpg';
const scheduleUrl = `${U}/04/Poster-TSAE-2026_Schedule_-V3_17-April_0.jpg`;

const subNav = [
  { href: '#speakers', label: 'Speakers' },
  { href: '#dates', label: 'Important Dates' },
  { href: '#fees', label: 'Fees' },
  { href: '#payment', label: 'Payment' },
