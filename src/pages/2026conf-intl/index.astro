<script>
  function initCountdown() {
    const el = document.getElementById('countdown');
    if (!el) return;
    const target = new Date(el.dataset.target || '').getTime();
    if (!target) return;
    const set = (u: string, v: number) => {
      const node = el.querySelector(`[data-cd="${u}"]`);
      if (node) node.textContent = String(v).padStart(2, '0');
    };
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) { set('days',0); set('hours',0); set('minutes',0); set('seconds',0); return; }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      set('days', d); set('hours', h); set('minutes', m); set('seconds', s);
    };
    tick();
    setInterval(tick, 1000);
  }

  function initProgrammeTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('#programme-tabs [data-day]');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    if (!tabs.length) return;
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.day;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.panel !== id);
        });
      });
    });
  }

  function initIntlPage() {
    initCountdown();
    initProgrammeTabs();
  }
  initIntlPage();
  document.addEventListener('astro:page-load', initIntlPage);
</script>
