const hybridNote = 'TSAE 2026 is held in a hybrid format. On-site participation accepts both oral and poster presentations, while virtual participation accepts oral presentations only. The presentation mode does not affect the review, publication, or indexing of accepted articles. All proceedings, certificates, and communications are distributed electronically.';

const manuscriptPrep = [
  'Template: use the official TSAE 2026 Paper Template with no modifications (download below).',
  'Length: 5–10 pages (double-column), including figures, tables, and references.',
  'Abstract: maximum 200 words. Keywords: maximum 6 (not repeating terms already in the title).',
  'References: 10–15 recommended; at most 3 conference proceedings; avoid self-citation above 10%.',
  'Language: English only — grammatically sound and clearly written.',
  'Figures: high quality (≥300 dpi for print, ≥150 dpi for online).',
];
const submissionSteps = [
  'Submit full papers (Word and PDF) online via the EasyChair system.',
  'First-time users must create an EasyChair account before submission.',
  'Select the single topic that best matches your manuscript.',
  'Enter the complete author list, affiliations, title, and all required information correctly.',
];
const reviewCriteria = [
  'Relevance to TSAE 2026 themes and topics',
  'Scientific quality, originality, and significance',
  'Soundness and rigour of the methodology',
  'Clarity of presentation, quality of English, and format compliance',
];
const ethicsNote = 'TSAE 2026 enforces a zero-tolerance policy on plagiarism. All submissions are screened with Turnitin; a similarity index above 25% results in a desktop reject without review. TSAE adheres to COPE and EDP Sciences publication ethics.';
const publicationNote = 'Accepted and presented full papers are published in E3S Web of Conferences (EDP Sciences), subject to final publisher checks, and indexed by Scopus. Copyright is retained by the author(s) under a Creative Commons Attribution (CC-BY) license.';

const scopeOriginality = [
  'Each manuscript must present original, unpublished scientific or technical work aligned with one or more TSAE 2026 themes, and must clearly state the research problem, methodology, application domain, and key contributions.',
  'Submissions must not be under review or published elsewhere; dual or near-duplicate submission is strictly prohibited.',
  'Each author may be listed as an author on a maximum of two submitted papers.',
  'The Program Committee reserves the right to reject any manuscript that exhibits excessive overlap in content or text.',
];
const reviewDecisions = 'Based on the reviewers’ recommendations, the Program Committee issues one of four decisions: accept, accept with minor revision, accept with major revision, or reject. Authors whose manuscripts require revision must address all reviewers’ comments and resubmit within the stated timeline using the Review Response Form below.';

// Author forms (originals provided by the organizing committee)
const reviewResponseUrl = '/downloads/TSAE2026-Review-Response-Form.docx';
const publicationRightUrl = '/downloads/TSAE2026-Publication-Right-Form.pdf';
const instructionsUrl = '/downloads/TSAE2026-Instructions-for-Authors.docx';

const bank = {
  name: 'KASIKORNBANK — Bang Khen Branch',
  swift: 'KASITHBK',
  branchAddr: '1456 Phaholyothin Rd., Lat Yao, Chatuchak, Bangkok 10900 · Tel. 02 093 1234',
  accName: 'THAI SOCIETY OF AGRICULTURAL ENGINEERING',
  accNo: '694-2-01262-2',
  societyAddr: 'Building 5, Floor 5, Department of Agricultural Extension, 2143/1 Phahonyothin Rd., Lat Yao, Chatuchak, Bangkok 10900, Thailand',
};
const paymentNotes = [
  'All transaction fees must be borne by the participant.',
  'The registration fee is non-refundable under any circumstances once paid, even if the registrant is unable to attend the conference.',
  'Please submit your proof of payment via EasyChair.',
];

// Paper template (E3S Web of Conferences style) — TSAE2026-Paper-Template.docx
const templateUrl = '/downloads/TSAE2026-Paper-Template.docx';
const templateSpecs = [
  { k: 'Page layout', v: 'A4 (210×297 mm); final printable area 172×252 mm. Margins — top 25, bottom 20, left 20, right 20 mm. Two-column layout with 8 mm column spacing. No page numbers.' },
  { k: 'Title', v: 'Arial 16 pt, bold, justified. Capitalise the first letter of each word (except prepositions). Leave 22 mm above and 6 mm below.' },
  { k: 'Authors & affiliations', v: 'First name(s) in italic 10 pt Times New Roman, last name in 10 pt; no academic titles. Affiliations 9 pt Times New Roman with numeric superscripts, including the country.' },
  { k: 'Abstract', v: 'Heading in bold 9 pt Arial; body in 9 pt Times New Roman, single paragraph, justified — maximum 200 words.' },
  { k: 'Body text', v: '10 pt Times New Roman, single line spacing, justified. The first paragraph of a section is not indented; following paragraphs indent 5 mm.' },
  { k: 'Headings', v: 'Section 12 pt Arial bold (1, 2, 3); subsection 10 pt Arial bold (1.1); sub-subsection 10 pt Arial italic (1.1.1).' },
  { k: 'Figures & tables', v: 'Captions 9 pt Times New Roman — table captions centred above, figure captions flush-left below. Black & white strongly encouraged; figure text ≈ 10 pt; lines ≥ 0.25 pt.' },
  { k: 'Equations', v: 'Centred and numbered on the right-hand side. Use italics for variables and bold for vectors; bracket order {[()]}.' },
  { k: 'References', v: 'Cited by sequential numbers in brackets, e.g. [1], [2, 5, 7], [8–10]; 10–15 references required, with at most 3 conference proceedings.' },
];

const presentOral = [
  'Oral presentation: 15 minutes total (10 minutes presentation + 5 minutes Q&A).',
  'A first warning is given near the time limit; a second warning signals the presenter to conclude and begin the Q&A.',
];
const presentOnline = [
  'Online presenters must submit a pre-recorded video (max 10 minutes).',
  'The video must reach the organizer no later than September 3, 2026.',
  'The Zoom ID and exact presentation time will be announced later.',
];
const presentPoster = [
  'Poster size: 60 cm (width) × 160 cm (height), one topic per sheet.',
  'Must include the title, all authors and affiliations, introduction, methodology, results, conclusions, references, plus the conference and TSAE logos.',
  'Each poster session lasts 10 minutes (5 minutes presentation + 5 minutes Q&A).',
  'Display period: September 8, 2026 (1:00 PM) – September 9, 2026 (4:00 PM).',
];

const nonPresentingIncludes = [
  'Accommodation: 3 nights of stay',
  'Catering: 2 meals and 3 coffee breaks',
  'Full access to all conference sessions, including keynote lectures',
  'Complimentary entry to the Taiwan Smart Agri-Week exhibition',
];

const venue = {
  name: 'Nangang International Exhibition Center (TaiNex 1), Hall 1',
  address: 'No.1, Jingmao 2nd Rd., Nangang District, Taipei City 11568, Taiwan ROC',
  tel: '+886-2-2725-5200',
};

// Scientific Committee
const committeeAcademic = [
