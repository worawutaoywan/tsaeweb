        <p class="text-slate-500 mt-3 text-sm leading-relaxed">
          Payment can be made by cash, telegraphic transfer, direct transfer, or any suitable method to the following bank account.
        </p>
      </div>

      <div class="bg-white rounded-xl ring-1 ring-slate-200 overflow-hidden max-w-4xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-3">
          <div class="flex items-center justify-center p-8" style="background:#0f2419;">
            <div class="text-center text-white">
              <div class="text-4xl font-semibold leading-none tracking-tight">K</div>
              <div class="text-[10px] font-medium tracking-[0.2em] mt-2 text-white/60">KASIKORNBANK</div>
            </div>
          </div>
          <div class="sm:col-span-2 p-6 sm:p-8">
            <dl class="space-y-4 text-sm">
              <div><dt class="text-[11px] uppercase tracking-wider text-slate-400 mb-0.5">Bank</dt><dd class="font-medium text-slate-900">{bank.name}</dd></div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><dt class="text-[11px] uppercase tracking-wider text-slate-400 mb-0.5">Account name</dt><dd class="font-medium text-slate-900">{bank.accName}</dd></div>
                <div><dt class="text-[11px] uppercase tracking-wider text-slate-400 mb-0.5">Account number</dt><dd class="font-semibold text-lg tabular-nums" style="color:#1a6b3a;">{bank.accNo}</dd></div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><dt class="text-[11px] uppercase tracking-wider text-slate-400 mb-0.5">SWIFT</dt><dd class="font-medium text-slate-900 tabular-nums">{bank.swift}</dd></div>
                <div><dt class="text-[11px] uppercase tracking-wider text-slate-400 mb-0.5">Branch</dt><dd class="text-slate-700">{bank.branchAddr}</dd></div>
              </div>
              <div><dt class="text-[11px] uppercase tracking-wider text-slate-400 mb-0.5">Account holder address</dt><dd class="text-slate-700 leading-relaxed">{bank.societyAddr}</dd></div>
            </dl>
          </div>
        </div>
      </div>

      <ul class="mt-8 space-y-2 text-sm text-slate-600 max-w-2xl mx-auto">
        {paymentNotes.map((n) => (
          <li class="flex gap-2.5"><span class="shrink-0 mt-2 w-1 h-1 rounded-full bg-[#c8a951]"></span><span>{n}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SUBMISSION GUIDELINES -->
  <section id="guidelines" class="intl-section scroll-mt-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="intl-eyebrow mb-3">Authors</p>
