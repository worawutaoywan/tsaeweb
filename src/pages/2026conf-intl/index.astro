        <p class="text-slate-500 mt-4 text-sm leading-relaxed">{hybridNote}</p>
      </div>

      <div class="rounded-xl ring-1 ring-slate-200 bg-slate-50/50 p-6 mb-6">
        <h3 class="font-semibold text-slate-900 mb-4">Scope &amp; originality</h3>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2.5 text-sm text-slate-600">
          {scopeOriginality.map((g) => (
            <li class="flex gap-2.5"><span class="shrink-0 mt-2 w-1 h-1 rounded-full bg-[#c8a951]"></span><span>{g}</span></li>
          ))}
        </ul>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-xl ring-1 ring-slate-200 bg-white p-6">
          <h3 class="font-semibold text-slate-900 mb-4">Manuscript preparation</h3>
          <ul class="space-y-2.5 text-sm text-slate-600">
            {manuscriptPrep.map((g) => (
              <li class="flex gap-2.5"><span class="shrink-0 mt-2 w-1 h-1 rounded-full bg-[#c8a951]"></span><span>{g}</span></li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl ring-1 ring-slate-200 bg-white p-6">
          <h3 class="font-semibold text-slate-900 mb-4">Paper submission</h3>
          <ul class="space-y-2.5 text-sm text-slate-600">
            {submissionSteps.map((g) => (
              <li class="flex gap-2.5"><span class="shrink-0 mt-2 w-1 h-1 rounded-full bg-[#c8a951]"></span><span>{g}</span></li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl ring-1 ring-slate-200 bg-white p-6">
          <h3 class="font-semibold text-slate-900 mb-4">Peer review &amp; decisions</h3>
          <ul class="space-y-2.5 text-sm text-slate-600">
            {reviewCriteria.map((g) => (
              <li class="flex gap-2.5"><span class="shrink-0 mt-2 w-1 h-1 rounded-full bg-[#c8a951]"></span><span>{g}</span></li>
            ))}
          </ul>
          <p class="text-sm text-slate-600 mt-4 leading-relaxed">{reviewDecisions}</p>
          <a href={reviewResponseUrl} download class="inline-flex items-center gap-2 mt-4 text-sm font-medium text-[#1a6b3a] hover:underline">
            Download Review Response Form (.docx)
          </a>
        </div>
        <div class="rounded-xl ring-1 ring-slate-200 bg-white p-6">
          <h3 class="font-semibold text-slate-900 mb-4">Ethics, copyright &amp; publication</h3>
          <p class="text-sm text-slate-600 mb-3 leading-relaxed">{ethicsNote}</p>
          <p class="text-sm text-slate-600 mb-3 leading-relaxed">{publicationNote}</p>
          <p class="text-sm text-slate-600 leading-relaxed">Authors must grant EDP Sciences a licence to publish and complete the Publication Right Form before publication.</p>
          <a href={publicationRightUrl} download class="inline-flex items-center gap-2 mt-4 text-sm font-medium text-[#1a6b3a] hover:underline">
            Download Publication Right Form (.pdf)
          </a>
        </div>
      </div>
      <div class="flex flex-wrap justify-center gap-3 mt-10">
        <a href={submitUrl} target="_blank" rel="noopener" class="intl-btn intl-btn-gold">Submit via EasyChair</a>
        <a href={instructionsUrl} download class="intl-btn intl-btn-outline">
          Instructions for Authors (.docx)
        </a>
      </div>
    </div>
  </section>

  <!-- PAPER TEMPLATE -->
  <section id="template" class="intl-section scroll-mt-24" style="background:#f4f6f4;">
