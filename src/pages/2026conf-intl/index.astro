---

<Layout title="19th TSAE International Conference 2026" description="19th Thai Society of Agricultural Engineering International Conference (TSAE 2026), September 7–10, 2026, Taipei, Taiwan ROC." lang="en" hideLangSwitch={true}>
  <!-- HERO -->
  <section class="relative overflow-hidden" style="background: linear-gradient(125deg, #1a9650 0%, #1a6b3a 48%, #0f7d5c 100%);">
    <!-- bright decorative glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-28 -right-24 w-[26rem] h-[26rem] rounded-full" style="background: radial-gradient(circle, rgba(200,169,81,0.55), transparent 70%);"></div>
      <div class="absolute -bottom-32 -left-24 w-[30rem] h-[30rem] rounded-full" style="background: radial-gradient(circle, rgba(74,222,128,0.45), transparent 70%);"></div>
      <div class="absolute top-1/4 left-1/3 w-80 h-80 rounded-full" style="background: radial-gradient(circle, rgba(255,255,255,0.16), transparent 70%);"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 py-20 lg:py-24 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-5 border border-yellow-300/40" style="background-color: rgba(200,169,81,0.2); color:#fde68a;">
        19th TSAE International Conference
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-4">TSAE 2026</h1>
      <p class="text-lg sm:text-2xl font-light text-green-100 max-w-3xl mx-auto mb-6">
        “Empowering Engineering Solutions for Future Agriculture in the New World Order”
      </p>
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-green-50 mb-8">
        <span class="inline-flex items-center gap-2"><svg class="w-5 h-5" style="color:#c8a951" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>September 7 – 10, 2026</span>
        <span class="inline-flex items-center gap-2"><svg class="w-5 h-5" style="color:#c8a951" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>Nangang Exhibition Center (TaiNex 1), Taipei, Taiwan ROC</span>
      </div>

      <!-- Countdown -->
      <div id="countdown" data-target="2026-09-07T09:00:00+08:00" class="flex justify-center gap-3 sm:gap-4 mb-8">
        {['days','hours','minutes','seconds'].map((u) => (
          <div class="w-20 sm:w-24 rounded-xl py-3 px-2" style="background-color: rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.15);">
            <div class="text-3xl sm:text-4xl font-extrabold text-white" data-cd={u}>--</div>
            <div class="text-[11px] uppercase tracking-wide text-green-200">{u}</div>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        <a href={submitUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl text-white shadow-lg transition-transform hover:scale-105" style="background-color:#c8a951;">
          Submit Your Paper
        </a>
        <a href={posterUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl border-2 border-white/60 text-white hover:bg-white/10 transition-colors">
          Conference Poster
        </a>
        <a href="#register" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl text-white shadow-lg transition-transform hover:scale-105" style="background-color:#1a6b3a; border:2px solid rgba(255,255,255,0.5);">
          Register to Attend
        </a>
      </div>
    </div>
  </section>

  <!-- SUB NAV -->
  <nav class="bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-4">
      <p class="text-center text-xs font-bold uppercase tracking-widest mb-3" style="color:#1a6b3a;">Jump to section</p>
      <ul class="flex flex-wrap justify-center gap-2.5 sm:gap-3 text-sm font-semibold">
        {subNav.map((n) => (
          <li>
            <a href={n.href} class="inline-block px-5 py-2.5 rounded-full text-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md" style="background-color:#1a6b3a;" onmouseover="this.style.backgroundColor='#13502b';" onmouseout="this.style.backgroundColor='#1a6b3a';">{n.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- BACKGROUND -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-6 text-center" style="color:#1a6b3a;">Background</h2>
      <p class="text-gray-600 leading-relaxed text-lg">
        The Thai Society of Agricultural Engineering (TSAE), in collaboration with the Taiwan Institute of
        Biological Mechatronics (TIBM), the Chinese Institute of Agricultural Machinery (CIAM) and the Smart
        Agriweek Taiwan exhibition, will hold the 19th TSAE International Conference (TSAE 2026) during
        September 7–10, 2026 in Taipei, Taiwan ROC. Under the theme “Empowering Engineering Solutions for
        Future Agriculture in the New World Order,” the conference serves as a forum for dissemination and
        exchange of ideas and recent advances in agricultural engineering and related areas among students,
        academic researchers, industry personnel and interested participants — with the aim of bringing
        research results into practice.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm">
        <span class="px-3 py-1.5 rounded-full bg-green-50 text-green-800 font-medium">Organized by TSAE · TIBM · CIAM · Smart Agriweek Taiwan</span>
        <span class="px-3 py-1.5 rounded-full font-medium" style="background-color:#fdf6e3; color:#a8892f;">Papers published in E3S Web of Conferences · Indexed by Scopus</span>
      </div>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="py-16" style="background-color:#f6faf7;">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-10 text-center" style="color:#1a6b3a;">Conference Topics</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {topics.map((tp) => (
          <div class="rounded-2xl overflow-hidden shadow-md bg-white hover:shadow-xl transition-shadow">
            <img src={tp.img} alt={tp.title} class="w-full h-32 object-cover" loading="lazy" />
            <div class="p-4">
              <p class="font-semibold text-gray-800">{tp.title}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KEYNOTE SPEAKERS -->
  <section id="speakers" class="py-16 bg-white scroll-mt-28">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-10 text-center" style="color:#1a6b3a;">Keynote Speakers</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {speakers.map((sp) => (
          <div class="flex gap-5 p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <img src={sp.photo} alt={sp.name} class="w-24 h-24 rounded-xl object-cover shrink-0" loading="lazy" />
            <div>
              <h3 class="text-lg font-bold text-gray-900">{sp.name}</h3>
              <p class="text-sm text-gray-500 mb-2">{sp.affil}</p>
              <p class="text-sm font-medium" style="color:#1a6b3a;">{sp.talk}</p>
              {sp.email && <a href={`mailto:${sp.email}`} class="text-xs text-gray-400 hover:text-green-700">{sp.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IMPORTANT DATES -->
  <section id="dates" class="py-16 scroll-mt-28" style="background:linear-gradient(135deg,#0d3b1e,#1a6b3a);">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-10 text-center text-white">Important Dates</h2>
      <div class="space-y-3">
        {importantDates.map((d) => (
          <div class="flex items-center justify-between gap-4 rounded-xl px-5 py-4" style={`background-color: ${d.highlight ? 'rgba(200,169,81,0.25)' : 'rgba(255,255,255,0.08)'}; border:1px solid rgba(255,255,255,0.12);`}>
            <span class="text-green-50">{d.label}</span>
            <span class="font-bold whitespace-nowrap" style={d.highlight ? 'color:#fde68a;' : 'color:#ffffff;'}>{d.date}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REGISTRATION FEES -->
  <section id="fees" class="py-16 bg-white scroll-mt-28">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-3 text-center" style="color:#1a6b3a;">Registration Fees</h2>
      <p class="text-center text-gray-500 mb-10">Early-bird rate valid until July 31, 2026</p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {[{title:'Online Participation', rows:feesOnline}, {title:'Onsite Participation (incl. 3-night accommodation)', rows:feesOnsite}].map((tb) => (
          <div class="rounded-2xl border border-gray-100 shadow-sm overflow-hidden flex flex-col">
            <div class="px-5 py-3 text-white font-semibold" style="background-color:#1a6b3a;">{tb.title}</div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[440px]">
                <thead>
                  <tr class="text-gray-500 text-left" style="background-color:#f6faf7;">
                    <th class="px-4 py-2 font-medium">Participant</th>
                    <th class="px-4 py-2 font-medium">Early Bird</th>
                    <th class="px-4 py-2 font-medium">Regular</th>
                  </tr>
                </thead>
                <tbody>
                  {tb.rows.map((r) => (
                    <tr class="border-t border-gray-100">
                      <td class="px-4 py-3 font-medium text-gray-800 whitespace-nowrap">{r.who}</td>
                      <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{r.early}</td>
                      <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{r.regular}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-6 text-center max-w-3xl mx-auto">
        Academic conference participants can enter the Taiwan Smart Agriweek exhibition for free. As part of a special
        promotional arrangement, participants who register under the non-member rate are eligible to apply for TSAE
        membership without any additional fee.
      </p>
    </div>
  </section>

  <!-- PAYMENT -->
  <section id="payment" class="py-16 scroll-mt-28" style="background-color:#f6faf7;">
    <div class="max-w-4xl mx-auto px-4">
