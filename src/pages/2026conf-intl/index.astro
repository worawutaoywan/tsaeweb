  <!-- UPLOAD PRESENTATION -->
  <section id="upload" class="intl-section scroll-mt-24" style="background:#f4f6f4;">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-8">
        <p class="intl-eyebrow mb-3">Presenters</p>
        <h2 class="intl-h2">Upload presentation file</h2>
        <p class="text-slate-500 mt-3 text-sm leading-relaxed">
