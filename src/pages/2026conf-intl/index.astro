  { name: 'Prof. Dr. Chang, Yaw-Nan (Nelson)', inst: 'National Formosa University, Taiwan' },
  { name: 'Dr. Martin Boruvka', inst: 'Technical University of Liberec, Czech Republic' },
  { name: 'Dr. Muhammad Hazwan Hamzah', inst: 'Universiti Putra Malaysia, Malaysia' },
  { name: 'Prof. Dr. Munehiro Tanaka', inst: 'Saga University, Japan' },
  { name: 'Assoc. Prof. Dr. Norhashila Binti Hashim', inst: 'Universiti Putra Malaysia, Malaysia' },
  { name: 'Prof. Dr. Rosnah Shamsudin', inst: 'Universiti Putra Malaysia, Malaysia' },
  { name: 'Prof. Dr. Shyam Sablani', inst: 'Washington State University, USA' },
  { name: 'Prof. Dr. Tri Ratna Bajracharya', inst: 'RIFS Research Institute Sustainability at GFZ, Potsdam, Germany' },
  { name: 'Prof. Dr. Vijaya G.S. Raghavan', inst: 'McGill University, Canada' },
