<Layout title="ประชุมวิชาการระดับชาติ ครั้งที่ 27 (TSAE 2026)" description="การประชุมวิชาการสมาคมวิศวกรรมเกษตรแห่งประเทศไทย ระดับชาติ ครั้งที่ 27 วันที่ 20–21 กรกฎาคม 2569 ณ กรมส่งเสริมการเกษตร" lang="th" hideLangSwitch={true}>
  <!-- HERO -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #0d3b1e 0%, #1a6b3a 55%, #124d2a 100%);">
    <div class="relative max-w-6xl mx-auto px-4 py-20 lg:py-24 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-5 border border-yellow-300/40" style="background-color: rgba(200,169,81,0.2); color:#fde68a;">
        การประชุมวิชาการระดับชาติ ครั้งที่ 27
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-4">TSAE 2026</h1>
      <p class="text-lg sm:text-2xl font-light text-green-100 max-w-3xl mx-auto mb-2">
        การประชุมวิชาการสมาคมวิศวกรรมเกษตรแห่งประเทศไทย ระดับชาติ
      </p>
      <p class="text-xl sm:text-2xl font-semibold mb-6" style="color:#fde68a;">
        “วิศวกรรมเกษตรแห่งอนาคตในระเบียบโลกใหม่”
      </p>
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-green-50 mb-8">
        <span class="inline-flex items-center gap-2"><svg class="w-5 h-5" style="color:#c8a951" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>20 – 21 กรกฎาคม 2569</span>
        <span class="inline-flex items-center gap-2"><svg class="w-5 h-5" style="color:#c8a951" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>ห้องประชุม 7 ชั้น 5 อาคาร 1 กรมส่งเสริมการเกษตร</span>
      </div>

      <!-- Countdown -->
      <div id="countdown" data-target="2026-07-20T08:30:00+07:00" class="flex justify-center gap-3 sm:gap-4 mb-8">
        {[['days','วัน'],['hours','ชั่วโมง'],['minutes','นาที'],['seconds','วินาที']].map(([u,label]) => (
          <div class="w-20 sm:w-24 rounded-xl py-3 px-2" style="background-color: rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.15);">
            <div class="text-3xl sm:text-4xl font-extrabold text-white" data-cd={u}>--</div>
            <div class="text-[11px] tracking-wide text-green-200">{label}</div>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        <a href={submitUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl text-white shadow-lg transition-transform hover:scale-105" style="background-color:#c8a951;">
          ส่งบทความ
        </a>
        <a href={posterUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl border-2 border-white/60 text-white hover:bg-white/10 transition-colors">
          โปสเตอร์งานประชุม
        </a>
        <a href={programUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl border-2 border-white/60 text-white hover:bg-white/10 transition-colors">
          กำหนดการ
        </a>
        <a href={proceedingUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl border-2 border-white/60 text-white hover:bg-white/10 transition-colors">
          Proceeding
        </a>
        <a href="#register" class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl text-white shadow-lg transition-transform hover:scale-105" style="background-color:#1a6b3a; border:2px solid rgba(255,255,255,0.5);">
          ลงทะเบียนเข้าร่วม
        </a>
      </div>
    </div>
  </section>

  <!-- SUB NAV -->
  <nav class="bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-4">
      <p class="text-center text-xs font-bold uppercase tracking-widest mb-3" style="color:#1a6b3a;">ไปยังหัวข้อ</p>
      <ul class="flex flex-wrap justify-center gap-2.5 sm:gap-3 text-sm font-semibold">
        {subNav.map((n) => (
          <li>
            <a href={n.href} class="inline-block px-5 py-2.5 rounded-full text-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md" style="background-color:#1a6b3a;" onmouseover="this.style.backgroundColor='#13502b';" onmouseout="this.style.backgroundColor='#1a6b3a';">{n.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- INTRO -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6" style="color:#1a6b3a;">เกี่ยวกับการประชุม</h2>
      <p class="text-gray-600 leading-relaxed text-lg">
        สมาคมวิศวกรรมเกษตรแห่งประเทศไทย จัดการประชุมวิชาการระดับชาติ ครั้งที่ 27 ภายใต้แนวคิด
        “วิศวกรรมเกษตรแห่งอนาคตในระเบียบโลกใหม่” เพื่อเป็นเวทีนำเสนอและแลกเปลี่ยนผลงานวิจัย
        องค์ความรู้ และนวัตกรรมด้านวิศวกรรมเกษตร ระหว่างนักวิจัย คณาจารย์ นิสิตนักศึกษา ภาคอุตสาหกรรม
        และผู้สนใจทั่วไป โดยจัดขึ้นในวันที่ 20–21 กรกฎาคม 2569 ณ กรมส่งเสริมการเกษตร
      </p>
      <div class="mt-8">
        <img src={`${U}/04/TSAE2026NationalConf-banner-1024x272.png`} alt="หน่วยงานสนับสนุน: สวก. (ARDA), วช. (NRCT), TSAE, สนช. (NIA)" class="max-w-full mx-auto" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="py-16" style="background-color:#f6faf7;">
    <div class="max-w-6xl mx-auto px-4">
