---
import Layout from '../../layouts/Layout.astro';
import RegisterForm from '../../components/RegisterForm.astro';

const U = '/wp-uploads/2026';

const topics = [
  { img: `${U}/01/b-01.png`, title: 'Plant, Animal & Aquacultural Production Engineering' },
