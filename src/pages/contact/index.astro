---
import Layout from '../../layouts/Layout.astro';
import AjaxFormScript from '../../components/AjaxFormScript.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';

const faqTH = [
  { q: 'จะสมัครสมาชิก TSAE ได้อย่างไร?', a: 'สมัครสมาชิกได้ทางออนไลน์ผ่านหน้า "สมาชิก" บนเว็บไซต์นี้ หรือส่งใบสมัครทางอีเมล center@tsae.asia พร้อมแนบหลักฐานการชำระเงิน' },
  { q: 'วารสาร สวกท. ออกเผยแพร่เมื่อไหร่?', a: 'วารสาร สวกท. ออกปีละ 2 ฉบับ คือ ฉบับที่ 1 (มกราคม-มิถุนายน) และฉบับที่ 2 (กรกฎาคม-ธันวาคม) สมาชิกสามัญรับวารสารฟรี' },
  { q: 'การส่งบทความวิจัยใช้เวลาพิจารณานานแค่ไหน?', a: 'กระบวนการ Peer Review ใช้เวลาประมาณ 4-8 สัปดาห์ ขึ้นอยู่กับการตอบรับจากผู้ทรงคุณวุฒิ' },
  { q: 'มีทุนสนับสนุนการเข้าร่วมประชุมนานาชาติหรือไม่?', a: 'TSAE มีทุนสนับสนุนค่าลงทะเบียนบางส่วนสำหรับสมาชิกที่นำเสนองานในการประชุม AAAE ติดต่อสำนักงานเพื่อสอบถามรายละเอียด' },
];

const faqEN = [
  { q: 'How do I join TSAE as a member?', a: 'You can apply online through the "Membership" page on this website, or email your application form with proof of payment to center@tsae.asia.' },
  { q: 'When is the TSAE Journal published?', a: 'The TSAE Journal is published twice a year: Issue 1 (January–June) and Issue 2 (July–December). Regular members receive the journal for free.' },
  { q: 'How long does the research article review process take?', a: 'The Peer Review process takes approximately 4–8 weeks, depending on responses from reviewers.' },
  { q: 'Is there funding support to attend international conferences?', a: 'TSAE provides partial registration support for members presenting at AAAE conferences. Contact the office for details.' },
];

const faqs = lang === 'th' ? faqTH : faqEN;

const topics = lang === 'th'
  ? [
      { value: 'membership', label: 'สมัครสมาชิก' },
      { value: 'journal', label: 'วารสาร สวกท.' },
      { value: 'conference', label: 'การประชุมวิชาการ' },
      { value: 'training', label: 'หลักสูตรอบรม' },
      { value: 'general', label: 'ข้อมูลทั่วไป' },
      { value: 'other', label: 'อื่นๆ' },
    ]
  : [
      { value: 'membership', label: 'Membership' },
      { value: 'journal', label: 'TSAE Journal' },
      { value: 'conference', label: 'Academic Conference' },
      { value: 'training', label: 'Training Courses' },
      { value: 'general', label: 'General Inquiry' },
      { value: 'other', label: 'Other' },
    ];
---

<Layout title={t('contact.title')} description={t('contact.subtitle')} lang={lang}>
  <div class="py-12" style="background: linear-gradient(135deg, #0d3b1e, #1a6b3a);">
    <div class="max-w-7xl mx-auto px-4">
      <nav class="flex items-center gap-2 text-sm text-green-300 mb-4">
        <a href={`${base}/`} class="hover:text-white transition-colors">{t('ui.home')}</a>
        <span>/</span>
        <span class="text-white">{t('nav.contact')}</span>
      </nav>
      <h1 class="text-4xl font-bold text-white mb-2">{t('contact.title')}</h1>
      <p class="text-green-200">{t('contact.subtitle')}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Contact Info -->
      <div class="lg:col-span-1 space-y-6">
        <h2 class="text-xl font-bold mb-6 pb-3 border-b-2" style="color: #1a6b3a; border-color: #c8a951;">{t('contact.info')}</h2>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-white shadow-sm border border-gray-100">
          <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #e8f5e9;">
            <svg class="w-5 h-5" style="color: #1a6b3a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">{t('contact.address')}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              {lang === 'th' ? (
                <>2143/1 อาคาร 5 ชั้น 5 กรมส่งเสริมการเกษตร<br />ลาดยาว จตุจักร<br />กรุงเทพฯ 10900</>
              ) : (
                <>2143/1 Building 5, 5th Floor<br />Department of Agricultural Extension<br />Lat Yao, Chatuchak, Bangkok 10900</>
              )}
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-white shadow-sm border border-gray-100">
          <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #e8f5e9;">
            <svg class="w-5 h-5" style="color: #1a6b3a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">{t('contact.phone')}</h3>
            <a href="tel:0818072458" class="text-sm font-medium transition-colors block" style="color: #1a6b3a;" onmouseover="this.style.color='#c8a951'" onmouseout="this.style.color='#1a6b3a'">081 807 2458</a>
            <p class="text-gray-500 text-xs mt-1">{t('contact.hours')}</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-white shadow-sm border border-gray-100">
          <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #e8f5e9;">
            <svg class="w-5 h-5" style="color: #1a6b3a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">{t('contact.email')}</h3>
            <a href="mailto:center@tsae.asia" class="text-sm font-medium block transition-colors" style="color: #1a6b3a;" onmouseover="this.style.color='#c8a951'" onmouseout="this.style.color='#1a6b3a'">center@tsae.asia</a>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-white shadow-sm border border-gray-100">
          <h3 class="font-semibold text-gray-900 mb-3">{lang === 'th' ? 'โซเชียลมีเดีย' : 'Social Media'}</h3>
          <div class="flex gap-3">
            <a href="https://www.facebook.com/tsaesocity" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg text-white text-sm font-medium" style="background-color: #1877f2;">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
            <a href="https://www.youtube.com/@TsaeAsiaGroup" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg text-white text-sm font-medium" style="background-color: #ff0000;">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              YouTube
            </a>
          </div>
        </div>

        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-200 h-48">
          <iframe
            src="https://www.google.com/maps?q=กรมส่งเสริมการเกษตร+ลาดยาว+จตุจักร+กรุงเทพ&z=16&output=embed"
            width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            title={lang === 'th' ? 'ที่ตั้งสมาคมวิศวกรรมเกษตรแห่งประเทศไทย' : 'TSAE Location Map'}
          ></iframe>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <h2 class="text-xl font-bold mb-6 pb-3 border-b-2" style="color: #1a6b3a; border-color: #c8a951;">{t('contact.form.title')}</h2>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
          <div class="p-1" style="background: linear-gradient(90deg, #1a6b3a, #c8a951);"></div>
          <div class="p-8">
            <p class="text-gray-600 text-sm mb-6">{t('contact.form.desc')}</p>
            <form
              action="/api/submit/contact"
              method="POST"
              class="tsae-ajax-form space-y-6"
              data-sending={lang === 'th' ? 'กำลังส่ง…' : 'Sending…'}
              data-err={lang === 'th' ? 'เกิดข้อผิดพลาด กรุณาตรวจสอบข้อมูลแล้วลองใหม่' : 'Something went wrong. Please check your input and try again.'}
              data-net={lang === 'th' ? 'เชื่อมต่อไม่สำเร็จ กรุณาลองใหม่' : 'Connection failed. Please try again.'}
              novalidate
            >
              <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;">
                <label>Company URL <input type="text" name="company_url" tabindex="-1" autocomplete="off" /></label>
                <input type="hidden" name="form_token" />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    {t('contact.form.name')} <span class="text-red-500">*</span>
                  </label>
                  <input type="text" name="name" required placeholder={lang === 'th' ? 'ชื่อ-นามสกุล' : 'Full name'} class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    {t('contact.form.email')} <span class="text-red-500">*</span>
                  </label>
                  <input type="email" name="email" required placeholder="email@example.com" class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm" />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    {lang === 'th' ? 'โทรศัพท์' : 'Phone'}
                  </label>
                  <input type="tel" name="phone" placeholder="08x-xxx-xxxx" class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    {lang === 'th' ? 'หน่วยงาน/องค์กร' : 'Organization'}
                  </label>
                  <input type="text" name="organization" placeholder={lang === 'th' ? 'ชื่อหน่วยงาน' : 'Organization name'} class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {t('contact.form.subject')} <span class="text-red-500">*</span>
                </label>
                <select name="topic" required class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm">
                  <option value="">{lang === 'th' ? 'เลือกหัวข้อ' : 'Select topic'}</option>
                  {topics.map((topic) => (
                    <option value={topic.value}>{topic.label}</option>
                  ))}
                </select>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {t('contact.form.message')} <span class="text-red-500">*</span>
                </label>
                <textarea name="message" required rows="6" placeholder={lang === 'th' ? 'กรุณาระบุรายละเอียดที่ต้องการสอบถาม...' : 'Please describe your inquiry in detail...'} class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm resize-y"></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input type="checkbox" id="consent" name="consent" required class="mt-1 w-4 h-4 rounded" />
                <label for="consent" class="text-sm text-gray-600">
                  {lang === 'th'
                    ? 'ฉันยอมรับว่าข้อมูลที่ให้ไว้จะถูกใช้เพื่อการติดต่อตอบกลับจาก TSAE เท่านั้น'
                    : 'I agree that the information provided will be used solely for TSAE to contact me in response.'}
                </label>
              </div>

              <p class="ajax-error hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-2.5"></p>
              <button type="submit" class="ajax-submit w-full py-4 text-white font-bold rounded-xl text-base transition-colors flex items-center justify-center gap-2 disabled:opacity-60" style="background-color: #1a6b3a;" onmouseover="this.style.backgroundColor='#124d2a'" onmouseout="this.style.backgroundColor='#1a6b3a'">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                {t('contact.form.send')}
              </button>
            </form>
            <div class="tsae-ajax-success hidden rounded-xl border p-8 text-center" style="background-color:#f0fdf4; border-color:#bbf7d0;">
              <div class="mx-auto w-14 h-14 rounded-full flex items-center justify-center mb-4" style="background-color:#1a6b3a;">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <h3 class="text-xl font-bold mb-1" style="color:#1a6b3a;">{lang === 'th' ? 'ส่งข้อความเรียบร้อย' : 'Message sent'}</h3>
              <p class="text-gray-600">{lang === 'th' ? 'ขอบคุณที่ติดต่อเรา ทีมงานจะติดต่อกลับโดยเร็วที่สุด' : 'Thank you for reaching out. Our team will get back to you as soon as possible.'}</p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div class="mt-10">
          <h3 class="text-xl font-bold mb-6" style="color: #1a6b3a;">
            {lang === 'th' ? 'คำถามที่พบบ่อย' : 'Frequently Asked Questions'}
          </h3>
          <div class="space-y-4">
            {faqs.map((faq, i) => (
              <div class="border border-gray-200 rounded-xl overflow-hidden">
                <button class="w-full flex items-center justify-between px-6 py-4 text-left bg-white hover:bg-gray-50 transition-colors faq-btn" data-target={`faq-${i}`}>
                  <span class="font-semibold text-gray-900 text-sm">{faq.q}</span>
                  <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div id={`faq-${i}`} class="hidden px-6 py-4 bg-gray-50 border-t border-gray-200">
                  <p class="text-sm text-gray-700 leading-relaxed">{faq.a}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <AjaxFormScript />
</Layout>

<style>
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: #1a6b3a;
    box-shadow: 0 0 0 2px rgba(26, 107, 58, 0.2);
  }
</style>

<script>
  function initFormTokens() {
    document.querySelectorAll<HTMLInputElement>('input[name="form_token"]').forEach((el) => {
      el.value = String(Math.floor(Date.now() / 1000));
    });
  }
  initFormTokens();
  document.addEventListener('astro:page-load', initFormTokens);

  document.querySelectorAll('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const target = document.getElementById(targetId || '');
      const icon = btn.querySelector('.faq-icon');
      if (target) {
        target.classList.toggle('hidden');
        icon?.classList.toggle('rotate-180');
      }
    });
  });
</script>
