---
import Layout from '../../layouts/Layout.astro';
import AjaxFormScript from '../../components/AjaxFormScript.astro';
import MembershipTypesGrid from '../../components/MembershipTypesGrid.astro';
import { membershipTypes } from '../../data/membershipTypes';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';
---

<Layout title={t('membership.title')} description={t('membership.subtitle')} lang={lang}>
  <div class="py-12" style="background: linear-gradient(135deg, #0d3b1e, #1a6b3a);">
    <div class="max-w-7xl mx-auto px-4">
      <nav class="flex items-center gap-2 text-sm text-green-300 mb-4">
        <a href={`${base}/`} class="hover:text-white transition-colors">{t('ui.home')}</a>
        <span>/</span>
        <span class="text-white">{t('membership.title')}</span>
      </nav>
      <h1 class="text-4xl font-bold text-white mb-2">{t('membership.title')}</h1>
      <p class="text-green-200">{t('membership.subtitle')}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-10 sm:py-12">
    <MembershipTypesGrid lang={lang} />

    <!-- How to Apply -->
    <div class="max-w-3xl mx-auto mb-12">
      <h2 class="text-xl font-bold text-center mb-5" style="color: #1a6b3a;">{t('membership.howto')}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {[
          { text: t('membership.step1') },
          { text: t('membership.step2') },
          { text: t('membership.step3') },
          { text: t('membership.step4') },
        ].map((step, i) => (
          <div class="flex gap-3 p-3 rounded-xl bg-white shadow-sm border border-gray-100">
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0" style="background-color: #1a6b3a;">{i + 1}</div>
            <div class="min-w-0">
              <p class="text-sm text-gray-700 leading-snug">{step.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-3 p-3 rounded-xl text-sm text-gray-600 text-center" style="background-color: #f0faf4;">
        {t('membership.bank')}
      </div>
    </div>

    <!-- Application Form -->
    <div id="apply" class="max-w-3xl mx-auto">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="p-1" style="background: linear-gradient(90deg, #1a6b3a, #c8a951);"></div>
        <div class="p-8">
          <h2 class="text-2xl font-bold mb-2" style="color: #1a6b3a;">
            {lang === 'th' ? 'แบบฟอร์มสมัครสมาชิก' : 'Membership Application Form'}
          </h2>
          <p class="text-gray-600 text-sm mb-8">
            {lang === 'th'
              ? 'กรอกข้อมูลด้านล่างเพื่อสมัครสมาชิก TSAE ทีมงานจะติดต่อกลับภายใน 3-5 วันทำการ'
              : 'Fill in the form below to apply for TSAE membership. Our team will contact you within 3-5 business days.'}
          </p>

          <form
            action="/api/submit/membership"
            method="POST"
            class="tsae-ajax-form space-y-6"
            data-sending={lang === 'th' ? 'กำลังส่ง…' : 'Sending…'}
            data-err={lang === 'th' ? 'เกิดข้อผิดพลาด กรุณาตรวจสอบข้อมูลแล้วลองใหม่' : 'Something went wrong. Please check your input and try again.'}
            data-net={lang === 'th' ? 'เชื่อมต่อไม่สำเร็จ กรุณาลองใหม่' : 'Connection failed. Please try again.'}
            enctype="multipart/form-data"
          >
            <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;">
              <label>Company URL <input type="text" name="company_url" tabindex="-1" autocomplete="off" /></label>
              <input type="hidden" name="form_token" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {lang === 'th' ? 'คำนำหน้า' : 'Title'} <span class="text-red-500">*</span>
                </label>
                <select name="prefix" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2">
                  <option value="">{lang === 'th' ? 'เลือกคำนำหน้า' : 'Select title'}</option>
                  {lang === 'th' ? (
                    <>
                      <option>นาย</option>
                      <option>นาง</option>
                      <option>นางสาว</option>
                      <option>ดร.</option>
                      <option>ผศ.ดร.</option>
                      <option>รศ.ดร.</option>
                      <option>ศ.ดร.</option>
                    </>
                  ) : (
                    <>
                      <option>Mr.</option>
                      <option>Mrs.</option>
                      <option>Ms.</option>
                      <option>Dr.</option>
                      <option>Asst. Prof. Dr.</option>
                      <option>Assoc. Prof. Dr.</option>
                      <option>Prof. Dr.</option>
                    </>
                  )}
                </select>
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {lang === 'th' ? 'ประเภทสมาชิก' : 'Membership Type'} <span class="text-red-500">*</span>
                </label>
                <select name="membershipType" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2">
                  <option value="">{lang === 'th' ? 'เลือกประเภทสมาชิก' : 'Select type'}</option>
                  {membershipTypes.map((m) => (
                    <option value={m.typeEN.toLowerCase().replace(' ', '-')}>
                      {lang === 'th' ? m.type : m.typeEN} (฿{m.fee}/{lang === 'th' ? m.feePeriodTH : m.feePeriodEN})
                    </option>
                  ))}
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {lang === 'th' ? 'ชื่อ' : 'First Name'} <span class="text-red-500">*</span>
                </label>
                <input type="text" name="firstName" required placeholder={lang === 'th' ? 'ชื่อ' : 'First name'} class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {lang === 'th' ? 'นามสกุล' : 'Last Name'} <span class="text-red-500">*</span>
                </label>
                <input type="text" name="lastName" required placeholder={lang === 'th' ? 'นามสกุล' : 'Last name'} class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {t('contact.form.email')} <span class="text-red-500">*</span>
                </label>
                <input type="email" name="email" required placeholder="email@example.com" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  {lang === 'th' ? 'โทรศัพท์' : 'Phone'} <span class="text-red-500">*</span>
                </label>
                <input type="tel" name="phone" required placeholder="08x-xxx-xxxx" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                {lang === 'th' ? 'หน่วยงาน/สถาบัน' : 'Organization/Institution'} <span class="text-red-500">*</span>
              </label>
              <input type="text" name="organization" required placeholder={lang === 'th' ? 'ชื่อหน่วยงานหรือสถาบันการศึกษา' : 'Name of organization or university'} class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2" />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                {lang === 'th' ? 'ข้อมูลเพิ่มเติม' : 'Additional Information'}
              </label>
              <textarea name="message" rows="3" placeholder={lang === 'th' ? 'ข้อมูลเพิ่มเติม หรือคำถามที่ต้องการสอบถาม (ถ้ามี)' : 'Additional information or questions (optional)'} class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 resize-y"></textarea>
            </div>

            <div class="rounded-xl border border-dashed p-4" style="border-color:#1a6b3a; background:#f0fdf4;">
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                {lang === 'th' ? 'แนบสลิปโอนเงิน' : 'Attach Payment Slip'} <span class="text-red-500">*</span>
              </label>
              <input type="file" name="payment_file" required accept=".pdf,.jpg,.jpeg,.png,.webp,.heic" class="w-full text-sm text-gray-600 file:mr-3 file:rounded-lg file:border-0 file:bg-[#1a6b3a] file:px-3 file:py-2 file:font-semibold file:text-white" />
              <p class="text-xs text-gray-500 mt-2">
                {lang === 'th'
                  ? 'จำเป็น · ไม่ต้องแนบใบสมัครกระดาษ กรอกฟอร์มออนไลน์ครบแล้วส่งสลิปอย่างเดียว'
                  : 'Required · No paper form needed — complete the online form and attach the payment slip only'}
              </p>
            </div>

            <p class="ajax-error hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-2.5"></p>
            <button type="submit" class="ajax-submit w-full py-4 text-white font-bold rounded-xl text-base transition-colors disabled:opacity-60" style="background-color: #1a6b3a;" onmouseover="this.style.backgroundColor='#124d2a'" onmouseout="this.style.backgroundColor='#1a6b3a'">
              {lang === 'th' ? 'ส่งใบสมัครสมาชิก' : 'Submit Application'}
            </button>
          </form>
          <div class="tsae-ajax-success hidden rounded-xl border p-8 text-center" style="background-color:#f0fdf4; border-color:#bbf7d0;">
            <div class="mx-auto w-14 h-14 rounded-full flex items-center justify-center mb-4" style="background-color:#1a6b3a;">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <h3 class="text-xl font-bold mb-1" style="color:#1a6b3a;">{lang === 'th' ? 'ส่งใบสมัครเรียบร้อย' : 'Application received'}</h3>
            <p class="text-gray-600">{lang === 'th' ? 'ขอบคุณ เราได้รับใบสมัครของคุณแล้ว ทีมงานจะติดต่อกลับภายใน 3-5 วันทำการ' : 'Thank you. We have received your application and will contact you within 3-5 business days.'}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Renew -->
    <div class="mt-16 max-w-3xl mx-auto">
      <div class="p-8 rounded-2xl border-2 text-center" style="border-color: #c8a951; background: linear-gradient(135deg, #fffbf0, #ffffff);">
        <h3 class="text-xl font-bold mb-3" style="color: #c8a951;">
          {lang === 'th' ? 'ต่ออายุสมาชิก' : 'Renew Membership'}
        </h3>
        <p class="text-gray-600 mb-6 text-sm">
          {lang === 'th'
            ? 'สมาชิกปัจจุบันที่ต้องการต่ออายุ กรุณาส่งอีเมลแจ้งความประสงค์พร้อมแจ้งชื่อ และ/หรือหมายเลขสมาชิก พร้อมแนบหลักฐานการชำระเงิน'
            : 'Current members who wish to renew, please email your renewal request with your name and/or membership number, attaching proof of payment.'}
        </p>
        <div class="flex justify-center">
          <a href={`mailto:center@tsae.asia?subject=${encodeURIComponent(lang === 'th' ? 'ต่ออายุสมาชิก TSAE' : 'TSAE Membership Renewal')}`} class="px-6 py-3 font-semibold rounded-xl text-white transition-colors" style="background-color: #c8a951;" onmouseover="this.style.backgroundColor='#a8892f'" onmouseout="this.style.backgroundColor='#c8a951'">
            {lang === 'th' ? 'ส่งอีเมลต่ออายุ' : 'Email Renewal'}
          </a>
        </div>
      </div>
    </div>
  </div>
  <AjaxFormScript />
  <script>
    function initFormTokens() {
      document.querySelectorAll<HTMLInputElement>('input[name="form_token"]').forEach((el) => {
        el.value = String(Math.floor(Date.now() / 1000));
      });
    }
    initFormTokens();
    document.addEventListener('astro:page-load', initFormTokens);
  </script>
</Layout>

<style>
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: #1a6b3a;
    box-shadow: 0 0 0 2px rgba(26, 107, 58, 0.2);
  }
</style>
