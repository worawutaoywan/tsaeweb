---
import PageHero from '../PageHero.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const th = lang === 'th';

// Source of truth: https://old.tsae.asia/home/privacy_policy/ (last updated 22 Dec 2023)
const sections: { h: string; p: string[] }[] = [
  { h: 'Overview', p: ['Thai Society of Agricultural Engineering recognizes the importance of the protection of your personal data. This Privacy Policy explains our practices regarding the collection, use or disclosure of personal data including other rights of the Data Subjects in accordance with the Personal Data Protection Laws.'] },
  { h: 'Collection of Personal Data', p: ['We will collect your personal data that we receive directly from you, such as: account registration, telephone number, and email address.'] },
  { h: 'Types of Data Collected', p: ['Personal data such as name, surname, age, date of birth, nationality, identification card, passport, etc.', 'Contact information such as address, telephone number, e-mail address, etc.', 'Account details such as username, password, transaction history, etc.', 'Technical data such as IP address, Cookie ID, Activity Log, etc.'] },
  { h: 'Use of Data', p: ['To create and manage accounts; share and manage information within the organization; gather user feedback; process payments; comply with our Terms and Conditions; and comply with laws, rules, and regulatory authorities.'] },
  { h: 'Data Retention', p: ['We will retain your personal data for as long as necessary during your relationship with us, or as necessary for the purposes set out in this Privacy Policy, unless law requires or permits a longer retention period. We will erase, destroy or anonymize your personal data when it is no longer necessary.'] },
  { h: 'Data Subject Rights', p: ['Subject to the Personal Data Protection Laws, you may exercise rights including: withdrawal of consent, data access, data portability, objection, data erasure or destruction, suspension of processing, rectification, and complaint lodging. We will notify the result of your request within 30 days upon receipt.'] },
  { h: 'Cookies', p: ['We use cookies or similar technologies to display personalized content and store your preferences. If you do not wish to have cookies placed on your computer, set your browser to refuse cookies before using our website.'] },
  { h: 'Data Security', p: ['We protect your personal data by establishing security measures in accordance with the principles of confidentiality, integrity, and availability to prevent loss, unauthorized access, destruction, use, alteration, or disclosure.'] },
  { h: 'Data Breach Notification', p: ['We will notify the Office of the Personal Data Protection Committee without delay and, where feasible, within 72 hours after becoming aware of a personal data breach, unless it is unlikely to result in a risk to your rights and freedoms.'] },
  { h: 'Changes to this Privacy Policy', p: ['We may change this Privacy Policy from time to time. This Privacy Policy was last updated and effective on 22 December 2023.'] },
];
---

<PageHero
  lang={lang}
  title={t('nav.privacy')}
  subtitle={th ? 'นโยบายความเป็นส่วนตัว (Privacy Policy)' : 'Privacy Policy'}
/>

<div class="max-w-3xl mx-auto px-4 py-14">
  <div class="prose prose-green max-w-none">
    {sections.map((s) => (
      <div class="mb-7">
        <h2 class="text-lg font-bold mb-2" style="color: #1a6b3a;">{s.h}</h2>
        {s.p.map((para) => <p class="text-gray-600 leading-relaxed mb-2">{para}</p>)}
      </div>
    ))}

    <div class="mt-10 rounded-2xl border border-gray-100 bg-gray-50 p-6">
      <h2 class="text-lg font-bold mb-3" style="color: #1a6b3a;">Contact Information</h2>
      <p class="text-sm text-gray-700 font-semibold">Data Controller</p>
      <p class="text-sm text-gray-600">Thai Society of Agricultural Engineering<br/>2143/1, Ladyao, Jatujak, Bangkok 10900<br/>
        <a href="mailto:center@tsae.asia" class="text-green-700 hover:underline">center@tsae.asia</a> · <a href="tel:0818072458" class="text-green-700 hover:underline">081 807 2458</a>
      </p>
      <p class="text-sm text-gray-700 font-semibold mt-4">Data Protection Officer</p>
      <p class="text-sm text-gray-600">Wachirasiri Tavidech<br/>2143/1, Ladyao, Jatujak, Bangkok 10900<br/>
        <a href="mailto:center@tsae.asia" class="text-green-700 hover:underline">center@tsae.asia</a> · <a href="tel:0818072458" class="text-green-700 hover:underline">081 807 2458</a>
      </p>
    </div>
  </div>
</div>
