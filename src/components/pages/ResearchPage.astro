---
import PageHero from '../PageHero.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';
const th = lang === 'th';

// Source of truth: https://old.tsae.asia/home/research/
const projects = [
  {
    title: 'โครงการศึกษาแนวทางการพัฒนาเครื่องจักรกลการเกษตรรองรับการผลิตเพื่อส่งออกผลไม้',
    titleEn: 'Study on the development of agricultural machinery to support fruit export production',
    docs: [
      { label: th ? 'บทสรุปผู้บริหาร' : 'Executive Summary', href: '/downloads/executive-summary-machinery-fruit-export.pdf' },
      { label: th ? 'รายงานฉบับสมบูรณ์' : 'Full Report', href: '/downloads/full-report-machinery-fruit-export.pdf' },
    ],
  },
  {
    title: 'โครงการวิจัยแนวทางการพัฒนาและยกระดับศักยภาพการส่งออกผลไม้ไทย',
    titleEn: 'Research on developing and enhancing the export potential of Thai fruit',
    docs: [
      { label: th ? 'รายงานฉบับย่อ (บทสรุปผู้บริหาร)' : 'Executive Summary Report', href: '/wp-uploads/2025/08/บทสรุปผู้บริหารโครงการยกระดับ-8-9-67_ตัด_23-9-2567_2024.pdf' },
      { label: th ? 'รายงานฉบับสมบูรณ์' : 'Full Report', href: '/wp-uploads/2025/05/รายงานฉบับสมบูรณ์-โครงการยกระดับ-31-7-67.pdf' },
    ],
  },
];
---

<PageHero
  lang={lang}
  title={t('nav.academic.research')}
  subtitle={th ? 'ผลงานวิจัยและโครงการของสมาคม' : 'Research projects of the association'}
  crumbs={[{ label: t('nav.academic'), href: `${base}/academic` }]}
/>

<div class="max-w-7xl mx-auto px-4 py-12">
  <div class="mb-10 rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm" style="background: linear-gradient(135deg, #f0faf4, #ffffff);">
    <h2 class="text-lg font-bold mb-2" style="color:#1a6b3a;">{th ? 'เกี่ยวกับงานวิจัย' : 'About research'}</h2>
    <p class="text-sm text-gray-600 leading-relaxed max-w-3xl">
      {th
        ? 'ผลงานวิจัยและโครงการที่สมาคมวิศวกรรมเกษตรแห่งประเทศไทยดำเนินการหรือมีส่วนร่วม เพื่อพัฒนาองค์ความรู้และเทคโนโลยีด้านวิศวกรรมเกษตร แต่ละโครงการสามารถเปิดอ่านบทสรุปผู้บริหารและรายงานฉบับสมบูรณ์ได้'
        : 'Research projects conducted or supported by the Thai Society of Agricultural Engineering to advance knowledge and technology in agricultural engineering. Each project provides an executive summary and full report.'}
    </p>
  </div>

  <h2 class="text-xl font-bold mb-5" style="color:#1a6b3a;">{th ? 'โครงการวิจัย' : 'Research projects'}</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {projects.map((p) => (
      <div class="group flex flex-col bg-white rounded-xl shadow-sm ring-1 ring-gray-100 overflow-hidden hover:shadow-lg hover:ring-green-200 hover:-translate-y-0.5 transition-all duration-300">
        <div class="relative p-5 overflow-hidden" style="background: linear-gradient(135deg, #0d3b1e 0%, #1a6b3a 70%, #24824a 100%);">
          <div class="absolute -right-6 -top-6 w-20 h-20 rounded-full" style="background: rgba(200,169,81,0.16);"></div>
          <div class="relative flex items-start gap-3">
            <div class="w-10 h-10 shrink-0 rounded-lg flex items-center justify-center" style="background: rgba(255,255,255,0.15);">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            </div>
            <h3 class="text-white font-bold text-sm leading-snug">{th ? p.title : p.titleEn}</h3>
          </div>
        </div>
        <div class="p-5 flex flex-wrap gap-2.5">
          {p.docs.map((d) => (
            <a href={d.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors" style="background-color:#1a6b3a14; color:#1a6b3a;" onmouseover="this.style.backgroundColor='#1a6b3a'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='#1a6b3a14'; this.style.color='#1a6b3a';">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              {d.label}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-10">
    <a href={`${base}/academic`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-gray-800 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      {t('nav.academic')}
    </a>
  </div>
</div>
