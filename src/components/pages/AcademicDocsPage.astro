---
import PageHero from '../PageHero.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';
const th = lang === 'th';

type DocLink = { label: string; href: string };
type Section = {
  id: string;
  title: string;
  intro: string;
  href: string;
  color: string;
  colorDark: string;
  tag: string;
  icon: string;
  external?: boolean;
  extraLinks?: DocLink[];
};

/** Same card style for every item — order: publications → projects → submit → strategy PDF */
const sections: Section[] = [
  {
    id: 'journal',
    title: t('nav.academic.journal'),
    intro: th
      ? 'วารสารสมาคมวิศวกรรมเกษตรแห่งประเทศไทย (วารสาร สวกท.) ตีพิมพ์ผลงานวิจัยและนวัตกรรมด้านวิศวกรรมเกษตร'
      : 'The TSAE Journal publishing research and innovation in agricultural engineering.',
    href: `${base}/journal`,
    color: '#d97706',
    colorDark: '#92400e',
    tag: th ? 'วารสาร' : 'Journal',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
  {
    id: 'proceeding',
    title: t('proceeding.title'),
    intro: th
      ? 'บทความวิชาการจากการประชุมวิชาการประจำปีของสมาคมฯ จัดเก็บตามปีการประชุม'
      : 'Academic papers from the annual TSAE conferences, organized by year.',
    href: `${base}/proceeding`,
    color: '#2563eb',
    colorDark: '#1e3a8a',
    tag: 'Proceeding',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    id: 'research',
    title: t('nav.academic.research'),
    intro: th
      ? 'ผลงานวิจัยและโครงการที่สมาคมดำเนินการหรือมีส่วนร่วม เพื่อพัฒนาองค์ความรู้และเทคโนโลยีด้านวิศวกรรมเกษตร'
      : 'Research projects conducted or supported by the association to advance agricultural engineering knowledge and technology.',
    href: `${base}/about/research`,
    color: '#1a6b3a',
    colorDark: '#0d3b1e',
    tag: th ? 'งานวิจัย' : 'Research',
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  },
  {
    id: 'projects',
    title: t('projconf.title'),
    intro: th
      ? 'บทความจากการประชุมวิชาการโครงงานวิศวกรรมเกษตรแห่งชาติ เวทีนำเสนอผลงานโครงงานของนักศึกษา'
      : 'Papers from the National Agricultural Engineering Project Conference for student project presentations.',
    href: `${base}/project-conference`,
    color: '#0d9488',
    colorDark: '#115e59',
    tag: th ? 'โครงงาน' : 'Projects',
    icon: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  },
  {
    id: 'submission',
    title: t('nav.academic.submission'),
    intro: th
      ? 'แนวทางและขั้นตอนการส่งบทความเพื่อตีพิมพ์ในวารสาร สวกท. ผ่านระบบ ThaiJO'
      : 'Guidelines and steps for submitting papers to the TSAE Journal via ThaiJO.',
    href: `${base}/submission`,
    color: '#7c3aed',
    colorDark: '#4c1d95',
    tag: th ? 'ตีพิมพ์' : 'Submit',
    icon: 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8',
  },
  {
    id: 'strategy',
    title: t('academic.strategy.title'),
    intro: t('academic.strategy.intro'),
    href: '/downloads/TSAE-machinery-strategy.pdf',
    color: '#b45309',
    colorDark: '#78350f',
    tag: 'PDF',
    icon: 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z M14 2v6h6 M9 13h6 M9 17h6',
    external: true,
    extraLinks: [
      { label: t('academic.strategy.fullDoc'), href: '/downloads/TSAE-machinery-strategy.pdf' },
      { label: t('academic.strategy.presentation'), href: '/downloads/TSAE-machinery-strategy-presentation.pdf' },
    ],
  },
];
---

<PageHero
  lang={lang}
  title={t('nav.academic')}
  subtitle={th ? 'แหล่งรวมเอกสารและบทความวิชาการของสมาคม' : 'Academic documents and articles of the association'}
/>

<div class="max-w-7xl mx-auto px-4 py-12">
  <div class="mb-10 rounded-2xl p-6 sm:p-8 border border-gray-100 shadow-sm relative overflow-hidden" style="background: linear-gradient(135deg, #f0faf4 0%, #ffffff 55%, #fffbeb 100%);">
    <div class="absolute -right-10 -top-10 w-40 h-40 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(26,107,58,0.08), transparent 70%);"></div>
    <div class="absolute -left-6 -bottom-8 w-32 h-32 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(200,169,81,0.12), transparent 70%);"></div>
    <div class="relative">
      <h2 class="text-lg font-bold mb-2" style="color:#1a6b3a;">{t('academic.about')}</h2>
      <p class="text-sm text-gray-600 leading-relaxed max-w-3xl">{t('academic.aboutDesc')}</p>
    </div>
  </div>

  <h2 class="text-xl font-bold mb-6" style="color:#1a6b3a;">{t('academic.listTitle')}</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {sections.map((s) => (
      s.extraLinks ? (
        <div
          id={s.id}
          class="flex flex-col bg-white rounded-2xl shadow-sm ring-1 ring-gray-100 overflow-hidden scroll-mt-24 h-full"
        >
          <div class="relative p-5 sm:p-6 overflow-hidden min-h-[8.25rem]" style={`background: linear-gradient(135deg, ${s.colorDark} 0%, ${s.color} 72%, ${s.color}cc 100%);`}>
            <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full pointer-events-none" style="background: rgba(255,255,255,0.1);"></div>
            <div class="relative flex items-start gap-3.5">
              <div class="w-11 h-11 shrink-0 rounded-xl flex items-center justify-center" style="background: rgba(255,255,255,0.18); backdrop-filter: blur(4px);">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={s.icon}/></svg>
              </div>
              <div class="min-w-0 flex-1">
                <span class="inline-block text-[10px] font-bold tracking-widest uppercase text-white/70 mb-1">{s.tag}</span>
                <h3 class="text-white font-bold text-sm sm:text-[0.9375rem] leading-snug line-clamp-3">{s.title}</h3>
              </div>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <p class="text-sm text-gray-600 leading-relaxed flex-1">{s.intro}</p>
            <div class="mt-4 pt-4 border-t border-gray-100 space-y-2">
              {s.extraLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors hover:bg-amber-50"
                  style={`color:${s.color};`}
                >
                  <span>{link.label}</span>
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a
          id={s.id}
          href={s.href}
          target={s.external ? '_blank' : undefined}
          rel={s.external ? 'noopener noreferrer' : undefined}
          class="group flex flex-col bg-white rounded-2xl shadow-sm ring-1 ring-gray-100 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 scroll-mt-24 h-full"
        >
          <div class="relative p-5 sm:p-6 overflow-hidden min-h-[8.25rem]" style={`background: linear-gradient(135deg, ${s.colorDark} 0%, ${s.color} 72%, ${s.color}cc 100%);`}>
            <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full pointer-events-none" style="background: rgba(255,255,255,0.1);"></div>
            <div class="relative flex items-start gap-3.5">
              <div class="w-11 h-11 shrink-0 rounded-xl flex items-center justify-center" style="background: rgba(255,255,255,0.18); backdrop-filter: blur(4px);">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={s.icon}/></svg>
              </div>
              <div class="min-w-0 flex-1">
                <span class="inline-block text-[10px] font-bold tracking-widest uppercase text-white/70 mb-1">{s.tag}</span>
                <h3 class="text-white font-bold text-sm sm:text-[0.9375rem] leading-snug line-clamp-3">{s.title}</h3>
              </div>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <p class="text-sm text-gray-600 leading-relaxed flex-1 line-clamp-3">{s.intro}</p>
            <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between gap-2">
              <span class="text-sm font-semibold transition-colors" style={`color:${s.color};`}>
                {s.external ? t('academic.openDoc') : t('academic.open')}
              </span>
              <span class="w-8 h-8 rounded-full flex items-center justify-center transition-all group-hover:translate-x-0.5" style={`background-color:${s.color}14; color:${s.color};`}>
                {s.external ? (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                ) : (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                )}
              </span>
            </div>
          </div>
        </a>
      )
    ))}
  </div>
</div>
