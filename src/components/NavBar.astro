---
import { useTranslations, getLocalizedUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import SiteSearch from './SiteSearch.astro';

interface Props {
  lang: Lang;
  url: URL;
  hideLangSwitch?: boolean;
}

const { lang, url, hideLangSwitch = false } = Astro.props;
const t = useTranslations(lang);
const currentPath = url.pathname;

const base = lang === 'th' ? '/th' : '';

type NavChild = { label: string; href: string };
type NavItem = {
  label: string;
  href: string;
  hubLabel?: string;
  children?: NavChild[];
};

const navItems: NavItem[] = [
  { label: t('nav.home'), href: `${base}/` },
  {
    label: t('nav.about'),
    href: `${base}/about`,
    hubLabel: t('nav.hub.about'),
    children: [
      { label: t('nav.about.regulations'),       href: `${base}/about/regulations` },
      { label: t('nav.about.committee'),         href: `${base}/about/committee` },
      { label: t('nav.about.academicCommittee'), href: `${base}/about/academic-committee` },
      { label: t('nav.about.coordinators'),      href: `${base}/about/coordinators` },
      { label: t('nav.about.members'),           href: `${base}/about/members` },
      { label: t('nav.network'),                 href: `${base}/network` },
    ],
  },
  {
    label: t('nav.news'),
    href: `${base}/news`,
    hubLabel: t('nav.hub.news'),
    children: [
      { label: t('nav.events.national'),      href: `/2026conf-national/` },
      { label: t('nav.events.international'), href: `/2026conf-intl/` },
      { label: t('nav.events.iaec'),          href: `/iaec2026/` },
      { label: t('nav.events.training'),      href: `${base}/training` },
    ],
  },
  { label: t('nav.certification'), href: `${base}/certification` },
  {
    label: t('nav.academicShort'),
    href: `${base}/academic`,
    hubLabel: t('nav.hub.academic'),
    children: [
      { label: t('nav.academic.research'),    href: `${base}/about/research` },
      { label: t('nav.academic.proceeding'),  href: `${base}/proceeding` },
      { label: t('nav.academic.projects'),    href: `${base}/project-conference` },
      { label: t('nav.academic.journal'),     href: `${base}/journal` },
      { label: t('nav.academic.submission'),  href: `${base}/submission` },
    ],
  },
  { label: t('nav.contact'), href: `${base}/contact` },
  { label: t('nav.join'), href: `${base}/membership` },
];

const isActive = (href: string) => {
  const clean = href.split('?')[0];
  if (clean === `${base}/` || clean === base) return currentPath === `${base}/` || currentPath === base || currentPath === '/';
  return currentPath === clean || currentPath.startsWith(clean + '/');
};

const switchLang: Lang = lang === 'en' ? 'th' : 'en';
const switchUrl = getLocalizedUrl(url, switchLang);
const switchLabel = lang === 'en' ? 'ภาษาไทย' : 'English';
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm" data-pagefind-ignore>
  <!-- Top bar -->
  <div style="background-color: #1a6b3a;" class="text-white text-xs py-1.5">
    <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
      <span class="hidden sm:block font-medium tracking-wide">{t('site.fullname')}</span>
      <div class="flex items-center gap-5">
        <a href="tel:0818072458" class="flex items-center gap-1 hover:text-yellow-300 transition-colors">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          081 807 2458
        </a>
        <a href="mailto:center@tsae.asia" class="flex items-center gap-1 hover:text-yellow-300 transition-colors">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/></svg>
          center@tsae.asia
        </a>
        <span class="w-px h-3.5 bg-white/30" aria-hidden="true"></span>
        <a href="https://www.facebook.com/tsaesocity" target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-yellow-300 transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
        </a>
        <a href="https://www.youtube.com/@TsaeAsiaGroup" target="_blank" rel="noopener" aria-label="YouTube" class="hover:text-yellow-300 transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.2a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 00.5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 002.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 002.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <nav class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={`${base}/`} class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/logo/logo-tsae-square.png" alt="TSAE Logo" class="h-11 w-auto" />
        <div class="hidden md:block leading-tight">
          <div class="font-bold text-base" style="color: #1a6b3a; font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: 0.02em;">TSAE</div>
          <div class="text-gray-400" style="font-size: 10px;">Thai Society of Agri. Eng.</div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden xl:flex items-center gap-0.5">
        {navItems.map((item) => (
          item.children ? (
            <div class="relative group flex items-stretch">
              {/* Label = go to hub page */}
              <a
                href={item.href}
                class={`relative pl-3 pr-1 py-2 text-sm font-medium transition-colors flex items-center rounded-l-md whitespace-nowrap ${
                  isActive(item.href) ? 'text-green-800' : 'text-gray-600 hover:text-green-800'
                }`}
              >
                {isActive(item.href) && (
                  <span class="absolute bottom-0 left-3 right-0 h-0.5 rounded-full" style="background-color: #1a6b3a;"></span>
                )}
                {item.label}
              </a>
              {/* Chevron = open submenu (hover also opens) */}
              <button
                type="button"
                class={`nav-dd-btn relative pr-2.5 pl-0.5 py-2 text-sm transition-colors flex items-center rounded-r-md ${
                  isActive(item.href) ? 'text-green-800' : 'text-gray-500 hover:text-green-800'
                }`}
                aria-label={`${item.label} submenu`}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {isActive(item.href) && (
                  <span class="absolute bottom-0 left-0 right-2.5 h-0.5 rounded-full" style="background-color: #1a6b3a;"></span>
                )}
                <svg class="w-3 h-3 opacity-60 group-hover:opacity-100 transition-transform group-hover:translate-y-0.5 group-[.is-open]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <div class="nav-dropdown absolute top-full left-0 mt-2 w-72 bg-white rounded-xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-[.is-open]:opacity-100 group-[.is-open]:visible transition-all duration-150 z-50 overflow-hidden">
                {/* Hub row — explicit “this is a page” */}
                <a
                  href={item.href}
                  class="flex items-center justify-between gap-3 px-4 py-3 text-sm font-semibold transition-colors"
                  style="color: #1a6b3a; background-color: #f0faf4;"
                >
                  <span>{item.hubLabel}</span>
                  <svg class="w-4 h-4 flex-shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <div class="border-t border-gray-100 py-1">
                  {item.children.map((child) => (
                    <a href={child.href} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-green-800 transition-colors whitespace-nowrap">
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <div class="relative">
              <a
                href={item.href}
                class={`relative px-3 py-2 text-sm font-medium transition-colors flex items-center rounded-md whitespace-nowrap ${
                  isActive(item.href) ? 'text-green-800' : 'text-gray-600 hover:text-green-800'
                }`}
              >
                {isActive(item.href) && (
                  <span class="absolute bottom-0 left-3 right-3 h-0.5 rounded-full" style="background-color: #1a6b3a;"></span>
                )}
                {item.label}
              </a>
            </div>
          )
        ))}
      </div>

      <!-- Right: Search + Lang switcher + Join + Hamburger -->
      <div class="flex items-center gap-2">
        <SiteSearch lang={lang} />

        {!hideLangSwitch && (
        <a
          href={switchUrl}
          class="hidden sm:inline-flex items-center gap-1.5 h-9 px-3.5 text-xs font-semibold rounded-lg border transition-colors"
          style="border-color: #1a6b3a; color: #1a6b3a;"
          onmouseover="this.style.backgroundColor='#1a6b3a'; this.style.color='white';"
          onmouseout="this.style.backgroundColor=''; this.style.color='#1a6b3a';"
          title={`Switch to ${switchLabel}`}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
          </svg>
          {switchLabel}
        </a>
        )}

        <a
          href={`${base}/membership`}
          class="hidden md:inline-flex items-center gap-1.5 h-9 px-4 text-white text-sm font-semibold rounded-lg transition-all hover:scale-105"
          style="background-color: #c8a951;"
          onmouseover="this.style.backgroundColor='#a8892f'"
          onmouseout="this.style.backgroundColor='#c8a951'"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
          {t('nav.join')}
        </a>

        <button id="mobile-menu-btn" class="xl:hidden h-9 w-9 flex items-center justify-center rounded-lg text-gray-500 hover:text-gray-800 hover:bg-gray-100 transition-colors" aria-label="Toggle menu">
          <svg class="w-5 h-5" id="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-5 h-5 hidden" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden xl:hidden border-t border-gray-100 py-3">
      {!hideLangSwitch && (
      <a href={switchUrl} class="flex items-center gap-2 px-3 py-2 mb-2 text-sm font-medium rounded-lg transition-colors" style="color: #1a6b3a; background-color: #f0faf4;">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
        </svg>
        {switchLabel}
      </a>
      )}

      {navItems.map((item) => (
        item.children ? (
          <div class="mobile-nav-item">
            <div class="flex items-stretch gap-1">
              <a
                href={item.href}
                class="flex-1 flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors"
                style={isActive(item.href) ? 'color: #1a6b3a; background-color: #f0faf4;' : 'color: #374151;'}
              >
                {item.label}
              </a>
              <button
                type="button"
                class="mobile-sub-toggle h-auto w-10 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 transition-colors flex-shrink-0"
                aria-label={`เปิดเมนูย่อย ${item.label}`}
                aria-expanded="false"
              >
                <svg class="w-4 h-4 mobile-chevron transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
            <div class="mobile-sub hidden pl-2 mb-1 mt-0.5">
              <a
                href={item.href}
                class="flex items-center justify-between gap-2 px-3 py-2.5 text-sm font-semibold rounded-lg mb-0.5"
                style="color: #1a6b3a; background-color: #f0faf4;"
              >
                <span>{item.hubLabel}</span>
                <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              {item.children.map((child) => (
                <a href={child.href} class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-green-700 hover:bg-green-50 rounded-lg transition-colors">
                  <span class="w-1 h-1 rounded-full bg-gray-300 flex-shrink-0"></span>
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <div class="mobile-nav-item">
            <a
              href={item.href}
              class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors"
              style={isActive(item.href) ? 'color: #1a6b3a; background-color: #f0faf4;' : 'color: #374151;'}
            >
              {item.label}
            </a>
          </div>
        )
      ))}
      <div class="mt-3 px-3">
        <a href={`${base}/membership`} class="flex items-center justify-center gap-2 w-full py-2.5 text-white font-semibold rounded-lg text-sm" style="background-color: #c8a951;">
          {t('nav.join')}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      menu?.classList.remove('hidden');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });

  // Mobile: chevron toggles submenu; label remains a real link to the hub page
  document.querySelectorAll('.mobile-nav-item').forEach((item) => {
    const toggle = item.querySelector('.mobile-sub-toggle');
    const sub = item.querySelector('.mobile-sub');
    const chevron = item.querySelector('.mobile-chevron');
    if (!toggle || !sub) return;
    toggle.addEventListener('click', () => {
      const open = sub.classList.toggle('hidden') === false;
      chevron?.classList.toggle('rotate-180', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  // Desktop: chevron click toggles open state (touch / keyboard); hover still works via CSS
  document.querySelectorAll('.nav-dd-btn').forEach((chevronBtn) => {
    const wrap = chevronBtn.closest('.group');
    if (!wrap) return;
    chevronBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const opening = !wrap.classList.contains('is-open');
      document.querySelectorAll('.group.is-open').forEach((el) => {
        if (el !== wrap) {
          el.classList.remove('is-open');
          el.querySelector('.nav-dd-btn')?.setAttribute('aria-expanded', 'false');
        }
      });
      wrap.classList.toggle('is-open', opening);
      chevronBtn.setAttribute('aria-expanded', opening ? 'true' : 'false');
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node | null;
    document.querySelectorAll('.group.is-open').forEach((el) => {
      if (target && !el.contains(target)) {
        el.classList.remove('is-open');
        el.querySelector('.nav-dd-btn')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
