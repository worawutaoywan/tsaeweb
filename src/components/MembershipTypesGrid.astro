---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { membershipIconPaths, membershipTypes } from '../data/membershipTypes';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const th = lang === 'th';
---

<div class="text-center mb-8">
  <h2 class="text-2xl font-bold mb-2" style="color: #1a6b3a;">{t('membership.types')}</h2>
  <p class="text-gray-600 text-sm max-w-2xl mx-auto">{t('membership.typesDesc')}</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4 mb-12">
  {membershipTypes.map((type) => (
    <div
      class={`relative bg-white rounded-xl overflow-hidden border transition-shadow hover:shadow-md flex flex-col ${type.featured ? 'shadow-md' : 'shadow-sm border-gray-100'}`}
      style={type.featured ? `border-color: ${type.color}; border-width: 2px;` : ''}
    >
      {type.featured && (
        <div class="text-center py-1 text-white text-[10px] font-bold uppercase tracking-wide" style={`background-color: ${type.color};`}>
          {t('membership.featured')}
        </div>
      )}
      <div class="p-4 flex flex-col flex-1">
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg shrink-0" style={`background-color: ${type.color}18; color: ${type.color};`}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={membershipIconPaths[type.key]} />
            </svg>
          </div>
          <div class="text-right leading-none">
            <span class="text-xl font-bold" style={`color: ${type.color};`}>฿{type.fee}</span>
            <span class="block text-[11px] text-gray-400 mt-0.5">/{th ? type.feePeriodTH : type.feePeriodEN}</span>
          </div>
        </div>

        <h3 class="text-sm font-bold text-gray-900 leading-snug">
          {th ? type.type : type.typeEN}
        </h3>
        <p class="text-[11px] text-gray-400 mb-2.5">
          {th ? type.typeEN : type.type}
        </p>

        <p class="text-[11px] text-gray-600 mb-3 leading-snug line-clamp-2">
          <span class="font-semibold text-gray-700">{t('membership.eligibility')}:</span>
          {' '}{th ? type.eligibilityTH : type.eligibilityEN}
        </p>

        <ul class="space-y-1.5 mb-4 flex-1">
          {(th ? type.benefitsTH : type.benefitsEN).map((benefit) => (
            <li class="flex items-start gap-1.5 text-xs text-gray-700 leading-snug">
              <svg class="w-3.5 h-3.5 flex-shrink-0 mt-0.5" style={`color: ${type.color};`} fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              {benefit}
            </li>
          ))}
        </ul>

        <a
          href="#apply"
          class="block w-full text-center py-2 rounded-lg font-semibold text-xs transition-colors"
          style={type.featured
            ? `background-color: ${type.color}; color: white;`
            : `border: 1.5px solid ${type.color}; color: ${type.color};`}
          onmouseover={`this.style.backgroundColor='${type.color}'; this.style.color='white';`}
          onmouseout={type.featured
            ? `this.style.backgroundColor='${type.color}'; this.style.color='white';`
            : `this.style.backgroundColor=''; this.style.color='${type.color}';`}
        >
          {t('membership.apply')}
        </a>
      </div>
    </div>
  ))}
</div>
