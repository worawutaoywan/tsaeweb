---
import type { Lang } from '../i18n/ui';
import { useTranslations, formatDate, localize } from '../i18n/utils';

interface Props {
  title: string;
  titleTH?: string;
  startDate: Date;
  endDate?: Date;
  location: string;
  locationTH?: string;
  type: string;
  status: string;
  registrationUrl?: string;
  image?: string;
  excerpt: string;
  excerptTH?: string;
  slug: string;
  lang?: Lang;
}

const { title, titleTH, startDate, endDate, location, locationTH, type, status, registrationUrl, image, excerpt, excerptTH, slug, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const typeLabels: Record<string, { label: string; color: string }> = {
  national: { label: t('type.national'), color: '#1a6b3a' },
  international: { label: t('type.international'), color: '#1e40af' },
  training: { label: t('type.training'), color: '#c8a951' },
  webinar: { label: t('type.webinar'), color: '#7c3aed' },
};

const statusLabels: Record<string, { label: string; color: string }> = {
  upcoming: { label: t('status.upcoming'), color: '#16a34a' },
  ongoing: { label: t('status.ongoing'), color: '#d97706' },
  past: { label: t('status.past'), color: '#6b7280' },
};

const typeInfo = typeLabels[type] || { label: type, color: '#6b7280' };
const statusInfo = statusLabels[status] || { label: status, color: '#6b7280' };

const formatEventDate = (d: Date) => formatDate(lang, d, { year: 'numeric', month: 'short', day: 'numeric' });

const dateStr = endDate
  ? `${formatEventDate(startDate)} – ${formatEventDate(endDate)}`
  : formatEventDate(startDate);

const displayTitle = localize(lang, title, titleTH);
const displayLocation = localize(lang, location, locationTH);
const displayExcerpt = localize(lang, excerpt, excerptTH);
---

<article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col group border border-gray-100">
  <!-- Image -->
  <div class="relative h-44 overflow-hidden flex-shrink-0" style="background: linear-gradient(135deg, #e8f5e9, #c8e6c9);">
    {image ? (
      <img
        src={image}
        alt={displayTitle}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        onerror="this.style.display='none';"
      />
    ) : null}
    <div class="absolute inset-0 flex items-center justify-center" style={image ? 'display:none' : ''}>
      <svg class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>

    <!-- Badges -->
    <div class="absolute top-3 left-3 flex gap-2">
      <span class="px-2.5 py-1 rounded-full text-xs font-semibold text-white" style={`background-color: ${typeInfo.color};`}>
        {typeInfo.label}
      </span>
    </div>
    <div class="absolute top-3 right-3">
      <span class="px-2.5 py-1 rounded-full text-xs font-semibold text-white" style={`background-color: ${statusInfo.color};`}>
        {statusInfo.label}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-semibold text-gray-900 mb-3 leading-snug group-hover:text-green-700 transition-colors line-clamp-2">
      {displayTitle}
    </h3>

    <div class="space-y-1.5 mb-3 text-sm text-gray-600">
      <div class="flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #1a6b3a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{dateStr}</span>
      </div>
      <div class="flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #1a6b3a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{displayLocation}</span>
      </div>
    </div>

    <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-2 flex-1">
      {displayExcerpt}
    </p>

    <div class="flex items-center gap-3 mt-auto">
      <a
        href={`/events/${slug}`}
        class="flex-1 text-center py-2 text-sm font-semibold rounded-lg border-2 transition-colors"
        style="border-color: #1a6b3a; color: #1a6b3a;"
        onmouseover="this.style.backgroundColor='#1a6b3a'; this.style.color='white';"
        onmouseout="this.style.backgroundColor=''; this.style.color='#1a6b3a';"
      >
        {t('ui.viewDetails')}
      </a>
      {registrationUrl && status === 'upcoming' && (
        <a
          href={registrationUrl}
          target="_blank"
          rel="noopener"
          class="flex-1 text-center py-2 text-sm font-semibold rounded-lg text-white transition-colors"
          style="background-color: #c8a951;"
          onmouseover="this.style.backgroundColor='#a8892f';"
          onmouseout="this.style.backgroundColor='#c8a951';"
        >
          {t('ui.register')}
        </a>
      )}
    </div>
  </div>
</article>
