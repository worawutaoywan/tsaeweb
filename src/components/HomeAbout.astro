---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import AboutPillars from './AboutPillars.astro';

interface Props {
  lang?: Lang;
  badge: string;
  title: string;
  desc1: string;
  desc2?: string;
}

const { lang = 'en', badge, title, desc1, desc2 } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';
---

<section class="py-14 sm:py-16" style="background: linear-gradient(135deg, #0d3b1e 0%, #1a6b3a 100%);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] mb-3" style="color:#e6cf8a;">{badge}</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white leading-tight mb-4">{title}</h2>
        <p class="text-green-200/90 text-sm leading-relaxed mb-3">{desc1}</p>
        {desc2 && <p class="text-green-200/90 text-sm leading-relaxed mb-6">{desc2}</p>}
        <div class="flex flex-wrap gap-3">
          <a
            href={`${base}/membership`}
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-lg text-white transition-colors"
            style="background-color:#c8a951;"
            onmouseover="this.style.backgroundColor='#a8892f'"
            onmouseout="this.style.backgroundColor='#c8a951'"
          >
            {t('nav.join')}
          </a>
          <a
            href={`${base}/about`}
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-lg text-white border border-white/40 hover:bg-white/10 transition-colors"
          >
            {t('ui.learnMore')}
          </a>
        </div>
      </div>
      <AboutPillars lang={lang} />
    </div>
  </div>
</section>
