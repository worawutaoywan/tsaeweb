---
import type { Lang } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';
import { getWatchCategories, getWatchPicks, getWatchVideos } from '../data/watchVideos';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isTH = lang === 'th';

const sectionBadge = isTH ? 'สื่อวิดีโอ' : 'TSAE Media';
const sectionTitle = isTH ? 'วิดีโอจากสมาคมฯ' : 'Watch & Learn';
const sectionDesc = isTH
  ? 'กดเล่นด้านล่าง หรือเลือกจากรายการแนะนำ'
  : 'Hit play below, or pick a suggested clip';
const picksLabel = isTH ? 'แนะนำ' : 'Picks';
const playlistLabel = isTH ? 'วิดีโอทั้งหมด' : 'All videos';
const articleLabel = isTH ? 'อ่านบทความ' : 'Read article';
const openLinkLabel = isTH ? 'เปิดลิงก์' : 'Open link';
const scrollHint = isTH ? 'เลื่อนดูเพิ่ม' : 'Scroll for more';
const filterLabel = isTH ? 'หมวด' : 'Topic';
const showingLabel = isTH ? 'แสดง' : 'Showing';

const videos = getWatchVideos(lang);
const picks = getWatchPicks(lang);
const categories = getWatchCategories(lang);
const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const featured = picks.find((v) => v.id) ?? videos.find((v) => v.id) ?? videos[0];

function formatCardDate(date: string, isThai: boolean) {
  const d = new Date(date + 'T12:00:00');
  if (Number.isNaN(d.getTime())) return '';
  return isThai
    ? d.toLocaleDateString('th-TH', { month: 'short', year: '2-digit' })
    : d.toLocaleDateString('en-GB', { month: 'short', year: '2-digit' });
}
---

<section class="video-feature py-14 sm:py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeading eyebrow={sectionBadge} title={sectionTitle} description={sectionDesc} />

    <!-- One stage: player + details + picks -->
    <div class="mb-8 grid grid-cols-1 lg:grid-cols-[minmax(0,1.55fr)_minmax(280px,1fr)] gap-4 lg:gap-5 items-start">
      <div class="yt-main relative w-full aspect-video rounded-xl overflow-hidden bg-black shadow-md ring-1 ring-black/5">
        {featured.id ? (
          <button type="button" class="yt-play group absolute inset-0 w-full h-full cursor-pointer" data-yt={featured.id} aria-label={featured.title}>
            <img src={thumb(featured.id)} alt="" class="yt-main-thumb w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" loading="eager" />
            <span class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></span>
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full shadow-xl transition-transform duration-300 group-hover:scale-110" style="background-color:#1a6b3a;">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </span>
          </button>
        ) : (
          <a href={featured.href} target="_blank" rel="noopener noreferrer" class="absolute inset-0 flex items-center justify-center bg-gray-900 text-white text-sm font-semibold">
            {openLinkLabel}
          </a>
        )}
      </div>

      <div class="yt-now-playing flex flex-col min-h-0">
        {featured.categoryLabel && (
          <span class="yt-now-cat self-start text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded mb-2" style="background:#1a6b3a; color:#fff;">{featured.categoryLabel}</span>
        )}
        {!featured.categoryLabel && <span class="yt-now-cat hidden"></span>}
        <h3 class="yt-now-title text-lg font-bold leading-snug mb-1.5" style="color:#143b22;">{featured.title}</h3>
        <p class="yt-now-summary text-gray-600 text-sm leading-relaxed mb-1.5 line-clamp-3">{featured.summary}</p>
        <p class="yt-now-meta text-gray-400 text-xs mb-3">{featured.meta}</p>
        <div class="yt-now-actions mb-4">
          {featured.web && (
            <a href={featured.web} target="_blank" rel="noopener noreferrer" class="yt-now-web inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg text-white hover:opacity-90" style="background:#1a6b3a;">
              {articleLabel}
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          )}
        </div>

        <div class="pt-3 border-t border-gray-100">
          <p class="text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-2">{picksLabel}</p>
          <div class="flex flex-col gap-1.5">
            {picks.map((v) => (
              <button
                type="button"
                class="yt-pick group text-left rounded-lg px-2 py-1.5 flex gap-2.5 items-center hover:bg-gray-50 transition-colors"
                data-yt={v.id}
                data-title={v.title}
                data-meta={v.meta}
                data-summary={v.summary}
                data-web={v.web ?? ''}
                data-thumb={v.id ? thumb(v.id) : ''}
                data-category={v.category ?? ''}
                data-cat-label={v.categoryLabel}
              >
                <span class="relative shrink-0 w-16 aspect-video rounded-md overflow-hidden bg-gray-200">
                  {v.id && <img src={thumb(v.id)} alt="" class="w-full h-full object-cover" loading="lazy" />}
                  <span class="absolute inset-0 flex items-center justify-center bg-black/25">
                    <span class="w-5 h-5 rounded-full flex items-center justify-center" style="background:#1a6b3a;">
                      <svg class="w-2.5 h-2.5 text-white ml-px" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                  </span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-gray-900 text-xs font-semibold leading-snug line-clamp-2 group-hover:text-green-800">{v.title}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Filters + rail as one block -->
    <div class="relative">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3">
        <div class="flex items-center gap-3 min-w-0">
          <h3 class="text-sm font-bold shrink-0" style="color:#143b22;">{playlistLabel}</h3>
          <span class="yt-filter-status text-gray-400 text-xs shrink-0">{showingLabel} {videos.length}/{videos.length}</span>
        </div>
        <div class="yt-filters flex flex-wrap gap-1.5" aria-label={filterLabel}>
          {categories.map((c, i) => (
            <button
              type="button"
              class={`yt-filter px-2.5 py-1 rounded-full text-xs font-semibold transition-all border ${i === 0 ? 'is-on' : ''}`}
              data-filter={c.key}
            >
              {c.label}
              <span class="yt-filter-count ml-0.5 opacity-60">({c.count})</span>
            </button>
          ))}
        </div>
      </div>

      <p class="text-gray-400 text-[11px] mb-2 sm:hidden">{scrollHint}</p>

      <button type="button" class="yt-rail-prev hidden sm:flex absolute left-0 top-[calc(50%+8px)] -translate-y-1/2 -translate-x-1 z-10 w-9 h-9 items-center justify-center rounded-full bg-white border border-gray-200 shadow text-gray-600 transition-all opacity-0 pointer-events-none hover:border-green-300" aria-label="Previous">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="yt-rail-next hidden sm:flex absolute right-0 top-[calc(50%+8px)] -translate-y-1/2 translate-x-1 z-10 w-9 h-9 items-center justify-center rounded-full bg-white border border-gray-200 shadow text-gray-600 transition-all opacity-0 pointer-events-none hover:border-green-300" aria-label="Next">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <div class="yt-rail flex gap-3 overflow-x-auto pb-2 scroll-smooth snap-x snap-mandatory" tabindex="0">
        {videos.map((v) => (
          v.isExternal ? (
            <a
              href={v.href}
              target="_blank"
              rel="noopener noreferrer"
              class="yt-card yt-card-ext snap-start shrink-0 w-[168px] sm:w-[184px] rounded-xl overflow-hidden border border-gray-100 bg-white hover:shadow-md hover:border-gray-200 transition-all no-underline group"
              data-category={v.category ?? ''}
            >
              <div class="aspect-video flex items-center justify-center bg-gray-50">
                <svg class="w-6 h-6 text-gray-300 group-hover:text-green-700 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h7v2H7v10h10v-5h2v7H5V5z"/></svg>
              </div>
              <div class="p-2.5">
                {v.categoryLabel && (
                  <span class="inline-block text-[9px] font-bold uppercase tracking-wide mb-1" style="color:#1a6b3a;">{v.categoryLabel}</span>
                )}
                <p class="text-gray-900 text-xs font-semibold leading-snug line-clamp-2">{v.title}</p>
              </div>
            </a>
          ) : (
            <button
              type="button"
              class={`yt-card yt-item snap-start shrink-0 w-[168px] sm:w-[184px] rounded-xl overflow-hidden border text-left transition-all group bg-white ${v.id === featured.id ? 'is-active' : 'border-gray-100 hover:shadow-md hover:border-gray-200'}`}
              data-yt={v.id}
              data-title={v.title}
              data-meta={v.meta}
              data-summary={v.summary}
              data-web={v.web ?? ''}
              data-thumb={thumb(v.id!)}
              data-category={v.category ?? ''}
              data-cat-label={v.categoryLabel}
            >
              <div class="relative aspect-video bg-gray-100 overflow-hidden">
                <img src={thumb(v.id!)} alt="" class="w-full h-full object-cover transition-transform duration-400 group-hover:scale-105" loading="lazy" />
                <span class="absolute bottom-1.5 right-1.5 text-[9px] font-semibold px-1.5 py-0.5 rounded bg-black/70 text-white">{formatCardDate(v.date, isTH)}</span>
              </div>
              <div class="p-2.5">
                {v.categoryLabel ? (
                  <span class="inline-block text-[9px] font-bold uppercase tracking-wide mb-1" style="color:#1a6b3a;">{v.categoryLabel}</span>
                ) : (
                  <span class="inline-block text-[9px] font-medium mb-1 text-gray-400">{v.meta.split(' · ')[0]}</span>
                )}
                <p class="text-gray-900 text-xs font-semibold leading-snug line-clamp-2">{v.title}</p>
              </div>
            </button>
          )
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .yt-rail {
    scrollbar-width: thin;
    scrollbar-color: #cfd8d3 transparent;
  }
  .yt-rail::-webkit-scrollbar { height: 5px; }
  .yt-rail::-webkit-scrollbar-thumb {
    background: #cfd8d3;
    border-radius: 999px;
  }
  .yt-card.is-active {
    border-color: #1a6b3a !important;
    box-shadow: 0 0 0 1px #1a6b3a, 0 6px 18px rgba(20, 59, 34, 0.1);
  }
  .yt-card.is-hidden { display: none !important; }
  .yt-rail-prev.is-visible,
  .yt-rail-next.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .yt-filter {
    background: #f3f4f6;
    color: #4b5563;
    border-color: transparent;
  }
  .yt-filter:hover {
    background: #eef6f0;
    color: #143b22;
  }
  .yt-filter.is-on {
    background: #1a6b3a !important;
    color: #fff !important;
    border-color: #1a6b3a !important;
  }
</style>

<script>
  function initVideoFeature() {
    const articleLabel = document.documentElement.lang === 'th' ? 'อ่านบทความ' : 'Read article';
    const showingTpl = document.documentElement.lang === 'th' ? 'แสดง' : 'Showing';

    document.querySelectorAll<HTMLElement>('.video-feature').forEach((root) => {
      if (root.dataset.ytReady === '1') return;
      root.dataset.ytReady = '1';

      const main = root.querySelector<HTMLElement>('.yt-main');
      const rail = root.querySelector<HTMLElement>('.yt-rail');
      const prevBtn = root.querySelector<HTMLElement>('.yt-rail-prev');
      const nextBtn = root.querySelector<HTMLElement>('.yt-rail-next');
      const nowTitle = root.querySelector<HTMLElement>('.yt-now-title');
      const nowMeta = root.querySelector<HTMLElement>('.yt-now-meta');
      const nowSummary = root.querySelector<HTMLElement>('.yt-now-summary');
      const nowCat = root.querySelector<HTMLElement>('.yt-now-cat');
      const nowActions = root.querySelector<HTMLElement>('.yt-now-actions');
      const filterStatus = root.querySelector<HTMLElement>('.yt-filter-status');
      if (!main || !rail) return;

      const totalCards = root.querySelectorAll<HTMLElement>('.yt-card').length;
      let playing = false;

      const updateNowPlaying = (title: string, meta: string, summary: string, web: string, catLabel: string) => {
        if (nowTitle) nowTitle.textContent = title;
        if (nowMeta) nowMeta.textContent = meta;
        if (nowSummary) nowSummary.textContent = summary;
        if (nowCat) {
          if (catLabel) {
            nowCat.textContent = catLabel;
            nowCat.classList.remove('hidden');
            nowCat.style.display = '';
          } else {
            nowCat.classList.add('hidden');
            nowCat.style.display = 'none';
          }
        }
        if (nowActions) {
          nowActions.innerHTML = web
            ? `<a href="${web}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg text-white hover:opacity-90" style="background:#1a6b3a;">${articleLabel}<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>`
            : '';
        }
      };

      const setActiveCard = (item: HTMLElement) => {
        root.querySelectorAll<HTMLElement>('.yt-item').forEach((b) => b.classList.remove('is-active'));
        if (item.classList.contains('yt-item')) {
          item.classList.add('is-active');
          item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      };

      const restoreFacade = (id: string, title: string, meta: string, summary: string, thumb: string, web: string, catLabel: string) => {
        playing = false;
        main.innerHTML = `
          <button type="button" class="yt-play group absolute inset-0 w-full h-full cursor-pointer" data-yt="${id}" aria-label="${title.replace(/"/g, '&quot;')}">
            <img src="${thumb}" alt="" class="yt-main-thumb w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" loading="lazy" />
            <span class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></span>
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full shadow-xl transition-transform duration-300 group-hover:scale-110" style="background-color:#1a6b3a;">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </span>
          </button>`;
        main.querySelector<HTMLElement>('.yt-play')?.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          if (btn.dataset.yt) play(btn.dataset.yt, title, meta, summary, thumb, web, catLabel);
        });
        updateNowPlaying(title, meta, summary, web, catLabel);
      };

      const play = (id: string, title: string, meta: string, summary: string, thumb: string, web: string, catLabel: string) => {
        playing = true;
        const iframe = document.createElement('iframe');
        iframe.className = 'absolute inset-0 w-full h-full';
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = title;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.setAttribute('allowfullscreen', '');
        main.innerHTML = '';
        main.appendChild(iframe);
        updateNowPlaying(title, meta, summary, web, catLabel);
      };

      const selectFromEl = (el: HTMLElement, autoplay = false) => {
        const id = el.dataset.yt;
        if (!id) return;
        const title = el.dataset.title ?? '';
        const meta = el.dataset.meta ?? '';
        const summary = el.dataset.summary ?? '';
        const web = el.dataset.web ?? '';
        const thumbUrl = el.dataset.thumb ?? '';
        const catLabel = el.dataset.catLabel ?? '';
        const match = root.querySelector<HTMLElement>(`.yt-item[data-yt="${id}"]`);
        if (match) setActiveCard(match);
        if (autoplay || playing) {
          play(id, title, meta, summary, thumbUrl, web, catLabel);
        } else {
          restoreFacade(id, title, meta, summary, thumbUrl, web, catLabel);
        }
      };

      main.querySelector<HTMLElement>('.yt-play')?.addEventListener('click', () => {
        const active = root.querySelector<HTMLElement>('.yt-item.is-active') ?? root.querySelector<HTMLElement>('.yt-pick');
        if (active?.dataset.yt) selectFromEl(active, true);
      });

      root.querySelectorAll<HTMLElement>('.yt-item, .yt-pick').forEach((item) => {
        item.addEventListener('click', () => selectFromEl(item, playing));
      });

      const applyFilter = (key: string) => {
        let visible = 0;
        root.querySelectorAll<HTMLElement>('.yt-card').forEach((card) => {
          const cat = card.dataset.category ?? '';
          const show = key === 'all' || cat === key;
          card.classList.toggle('is-hidden', !show);
          if (show) visible += 1;
        });
        if (filterStatus) filterStatus.textContent = `${showingTpl} ${visible}/${totalCards}`;
        root.querySelectorAll<HTMLElement>('.yt-filter').forEach((btn) => {
          btn.classList.toggle('is-on', btn.dataset.filter === key);
        });
        updateArrows();
      };

      root.querySelectorAll<HTMLElement>('.yt-filter').forEach((btn) => {
        btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all'));
      });

      const updateArrows = () => {
        if (!prevBtn || !nextBtn) return;
        const max = rail.scrollWidth - rail.clientWidth;
        prevBtn.classList.toggle('is-visible', rail.scrollLeft > 8);
        nextBtn.classList.toggle('is-visible', max > 8 && rail.scrollLeft < max - 8);
      };

      prevBtn?.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth * 0.75, behavior: 'smooth' }));
      nextBtn?.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth * 0.75, behavior: 'smooth' }));
      rail.addEventListener('scroll', updateArrows, { passive: true });
      updateArrows();
      window.addEventListener('resize', updateArrows, { passive: true });
    });
  }
  initVideoFeature();
  document.addEventListener('astro:page-load', initVideoFeature);
</script>
