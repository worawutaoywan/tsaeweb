---
import type { Lang } from '../i18n/ui';
import type { JournalIssue } from '../data/journalIssues';

interface Props {
  lang: Lang;
  issue: JournalIssue;
}
const { lang, issue } = Astro.props;
const th = lang === 'th';
const label = th ? 'วารสาร สวกท.' : 'TSAE Journal';
const title = th
  ? `ปีที่ ${issue.volume} ฉบับที่ ${issue.issue}`
  : `Vol. ${issue.volume} No. ${issue.issue}`;
const beYear = issue.year + 543;
---

<article class="group flex flex-col bg-white rounded-xl shadow-sm ring-1 ring-gray-100 overflow-hidden hover:shadow-lg hover:ring-transparent hover:-translate-y-0.5 transition-all duration-300">
  <div class="relative aspect-[3/2] overflow-hidden" style="background: linear-gradient(150deg, #0d3b1e 0%, #1a6b3a 60%, #24824a 100%);">
    <div class="absolute top-0 inset-x-0 h-1" style="background: linear-gradient(90deg, #c8a951, #e6cf8a);"></div>
    <div class="absolute -right-8 -top-8 w-24 h-24 rounded-full" style="background: rgba(200,169,81,0.14);"></div>
    <div class="absolute -left-8 -bottom-8 w-28 h-28 rounded-full" style="background: rgba(255,255,255,0.05);"></div>

    <div class="relative h-full flex flex-col items-center justify-center text-center px-3">
      <div class="text-[9px] font-semibold tracking-[0.22em] uppercase mb-1" style="color:#e6cf8a;">{label}</div>
      <div class="flex items-baseline gap-1.5 text-white leading-none">
        <span class="text-4xl font-extrabold tracking-tight">{issue.volume}</span>
        <span class="text-lg font-semibold text-green-100">/ {issue.issue}</span>
      </div>
      <div class="mt-1.5 text-[10px] font-medium tracking-wide text-green-100">{th ? `ปีที่ ${issue.volume} · ฉบับที่ ${issue.issue}` : `Volume ${issue.volume} · Issue ${issue.issue}`}</div>
      <div class="mt-2 px-2.5 py-0.5 rounded-full text-[10px] font-semibold" style="background: rgba(255,255,255,0.16); color:#fff;">{issue.year}</div>
    </div>
  </div>

  <div class="flex items-center justify-between gap-2 p-3.5">
    <div class="min-w-0">
      <div class="text-[13px] font-bold text-gray-900 truncate">{title}</div>
      <div class="text-[11px] text-gray-500">{th ? `พ.ศ. ${beYear}` : issue.year}</div>
    </div>
    <a href={issue.url} target="_blank" rel="noopener" aria-label={th ? `อ่านฉบับ ${title}` : `Read ${title}`} class="shrink-0 inline-flex items-center gap-1 text-xs px-3 py-1.5 rounded-lg text-white font-semibold transition-colors" style="background-color: #1a6b3a;" onmouseover="this.style.backgroundColor='#124d2a'" onmouseout="this.style.backgroundColor='#1a6b3a'">
      {th ? 'อ่าน' : 'Read'}
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>
  </div>
</article>
