---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
const base = lang === 'th' ? '/th' : '';
---

<footer style="background-color: #1a2e1a;" class="text-white" data-pagefind-ignore>
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Organization info -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <img src="/images/logo/logo-tsae-square.png" alt="TSAE Logo" class="h-12 w-12 object-contain shrink-0" />
          <div class="min-w-0">
            <div class="font-bold text-white text-sm leading-snug">{t('site.fullname')}</div>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          {t('footer.desc')}
        </p>
        <div class="flex gap-3">
          <a href="https://www.facebook.com/tsaesocity" target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 rounded-full flex items-center justify-center transition-colors" style="background-color: #2d4a2d;" onmouseover="this.style.backgroundColor='#c8a951'" onmouseout="this.style.backgroundColor='#2d4a2d'">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@TsaeAsiaGroup" target="_blank" rel="noopener" aria-label="YouTube" class="w-9 h-9 rounded-full flex items-center justify-center transition-colors" style="background-color: #2d4a2d;" onmouseover="this.style.backgroundColor='#c8a951'" onmouseout="this.style.backgroundColor='#2d4a2d'">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
          <a href="mailto:center@tsae.asia" aria-label="Email" class="w-9 h-9 rounded-full flex items-center justify-center transition-colors" style="background-color: #2d4a2d;" onmouseover="this.style.backgroundColor='#c8a951'" onmouseout="this.style.backgroundColor='#2d4a2d'">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-bold mb-4 text-sm uppercase tracking-wider" style="color: #c8a951;">{t('footer.quicklinks')}</h3>
        <ul class="space-y-2">
          {[
            { label: t('ui.home'), href: `${base}/` },
            { label: t('nav.about'), href: `${base}/about` },
            { label: t('nav.news'), href: `${base}/news` },
            { label: t('nav.events'), href: `${base}/events` },
            { label: t('nav.certification'), href: `${base}/certification` },
            { label: t('nav.academic'), href: `${base}/academic` },
            { label: t('nav.network'), href: `${base}/network` },
            { label: t('membership.title'), href: `${base}/membership` },
            { label: t('nav.contact'), href: `${base}/contact` },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 text-sm hover:text-white transition-colors flex items-center gap-1">
                <span style="color: #c8a951;">›</span> {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Activities -->
      <div>
        <h3 class="text-white font-bold mb-4 text-sm uppercase tracking-wider" style="color: #c8a951;">{t('footer.activities')}</h3>
        <ul class="space-y-2">
          {[
            { label: t('nav.events.national'), href: `/2026conf-national/` },
            { label: t('nav.events.international'), href: `/2026conf-intl/` },
            { label: t('nav.events.iaec'), href: `/iaec2026/` },
            { label: t('nav.events.training'), href: `${base}/training` },
            { label: t('nav.events'), href: `${base}/events` },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 text-sm hover:text-white transition-colors flex items-center gap-1">
                <span style="color: #c8a951;">›</span> {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold mb-4 text-sm uppercase tracking-wider" style="color: #c8a951;">{t('footer.contact')}</h3>
        <div class="space-y-3 text-sm text-gray-400">
          <div class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #c8a951;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <p>2143/1 อาคาร 5 ชั้น 5 กรมส่งเสริมการเกษตร</p>
              <p>ลาดยาว จตุจักร</p>
              <p>กรุงเทพฯ 10900</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" style="color: #c8a951;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:0818072458" class="hover:text-white transition-colors">081 807 2458</a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" style="color: #c8a951;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:center@tsae.asia" class="hover:text-white transition-colors">center@tsae.asia</a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" style="color: #c8a951;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <a href="https://www.tsae.asia" target="_blank" rel="noopener" class="hover:text-white transition-colors">www.tsae.asia</a>
          </div>
        </div>

        <!-- Partner logos placeholder -->
        <div class="mt-6">
          <p class="text-xs text-gray-500 mb-2">{t('footer.member')}</p>
          <div class="flex items-center gap-2">
            <div class="w-10 h-10 rounded bg-gray-700 flex items-center justify-center text-xs text-gray-400">AAAE</div>
            <div class="w-10 h-10 rounded bg-gray-700 flex items-center justify-center text-xs text-gray-400">CIGR</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-500">
      <p>© {currentYear} {t('site.fullname')} (TSAE). {t('footer.rights')}</p>
      <div class="flex gap-4">
        <a href={`${base}/about/regulations`} class="hover:text-gray-300 transition-colors">{t('nav.about.regulations')}</a>
        <a href={`${base}/privacy`} class="hover:text-gray-300 transition-colors">{t('nav.privacy')}</a>
        <a href={`${base}/contact`} class="hover:text-gray-300 transition-colors">{t('nav.contact')}</a>
        <a href={`${base}/sitemap`} class="hover:text-gray-300 transition-colors">{lang === 'th' ? 'แผนผังเว็บไซต์' : 'Sitemap'}</a>
      </div>
    </div>
  </div>
</footer>
