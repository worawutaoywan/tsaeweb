---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  lang: Lang;
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
}

const { lang, title, subtitle, crumbs = [] } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';
---

<div class="py-12" style="background: linear-gradient(135deg, #0d3b1e, #1a6b3a);">
  <div class="max-w-7xl mx-auto px-4">
    <nav class="flex items-center flex-wrap gap-2 text-sm text-green-300 mb-4">
      <a href={`${base}/`} class="hover:text-white transition-colors">{t('ui.home')}</a>
      {crumbs.map((c) => (
        <>
          <span>/</span>
          <a href={c.href} class="hover:text-white transition-colors">{c.label}</a>
        </>
      ))}
      <span>/</span>
      <span class="text-white">{title}</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">{title}</h1>
    {subtitle && <p class="text-green-200">{subtitle}</p>}
  </div>
</div>
