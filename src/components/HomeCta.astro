---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  buttonLabel: string;
}

const { lang = 'en', title, description, buttonLabel } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'th' ? '/th' : '';
---

<section class="py-14 sm:py-16" style="background: linear-gradient(90deg, #c8a951, #a8892f);">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-white leading-tight mb-3">{title}</h2>
    <p class="text-white/90 text-sm sm:text-base leading-relaxed mb-7">{description}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href={`${base}/membership`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-white text-sm font-bold rounded-lg shadow-sm hover:shadow-md transition-shadow"
        style="color:#1a6b3a;"
      >
        {buttonLabel}
      </a>
      <a
        href={`${base}/about`}
        class="inline-flex items-center gap-2 px-6 py-3 text-white text-sm font-bold rounded-lg border border-white/50 hover:bg-white/10 transition-colors"
      >
        {t('ui.learnMore')}
      </a>
    </div>
  </div>
</section>
