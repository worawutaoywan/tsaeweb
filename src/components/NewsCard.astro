---
import type { Lang } from '../i18n/ui';
import { useTranslations, formatDate, localize } from '../i18n/utils';

interface Props {
  title: string;
  titleTH?: string;
  date: Date;
  category: string;
  excerpt: string;
  excerptTH?: string;
  image?: string;
  slug: string;
  featured?: boolean;
  lang?: Lang;
}

const { title, titleTH, date, category, excerpt, excerptTH, image, slug, featured, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const categoryLabels: Record<string, { label: string; color: string }> = {
  conference: { label: t('cat.conference'), color: '#1a6b3a' },
  journal: { label: t('cat.journal'), color: '#7c3aed' },
  training: { label: t('cat.training'), color: '#c8a951' },
  announcement: { label: t('cat.announcement'), color: '#dc2626' },
  activity: { label: t('cat.activity'), color: '#0891b2' },
};

const catInfo = categoryLabels[category] || { label: category, color: '#6b7280' };

const formattedDate = formatDate(lang, date);
const displayTitle = localize(lang, title, titleTH);
const displayExcerpt = localize(lang, excerpt, excerptTH);
---

<article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col group">
  <!-- Image -->
  <div class="relative overflow-hidden h-48 bg-gradient-to-br from-green-100 to-green-200 flex-shrink-0">
    {image ? (
      <img
        src={image}
        alt={displayTitle}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    ) : null}
    <div class={`w-full h-full flex items-center justify-center ${image ? 'hidden' : 'flex'}`}>
      <svg class="w-12 h-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
      </svg>
    </div>

    <!-- Category badge -->
    <div class="absolute top-3 left-3">
      <span class="px-2.5 py-1 rounded-full text-xs font-semibold text-white" style={`background-color: ${catInfo.color};`}>
        {catInfo.label}
      </span>
    </div>

    {featured && (
      <div class="absolute top-3 right-3">
        <span class="px-2.5 py-1 rounded-full text-xs font-semibold" style="background-color: #c8a951; color: white;">
          {t('ui.featured')}
        </span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center gap-1 text-xs text-gray-500 mb-2">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <h3 class="font-semibold text-gray-900 mb-2 leading-snug flex-1 group-hover:text-green-700 transition-colors line-clamp-2">
      {displayTitle}
    </h3>

    <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3">
      {displayExcerpt}
    </p>

    <a
      href={`/news/${slug}`}
      class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors mt-auto"
      style="color: #1a6b3a;"
      onmouseover="this.style.color='#c8a951'"
      onmouseout="this.style.color='#1a6b3a'"
    >
      {t('ui.readMore')}
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
