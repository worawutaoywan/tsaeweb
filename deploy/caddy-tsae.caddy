# TSAE site block — append to /etc/caddy/Caddyfile on root@104.248.152.59
# DNS: tsae.asia + www.tsae.asia A -> 104.248.152.59
# Web root: /var/www/tsae_web
# API: docker tsae_registration on 127.0.0.1:8090

http://tsae.asia, http://www.tsae.asia {
	root * /var/www/tsae_web

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	# WP media (local wp-uploads/ — run ./deploy.sh uploads to sync)
	handle /wp-uploads/* {
		root * /var/www/tsae_web
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	handle /_astro/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.webp *.pdf *.docx
	handle @static {
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/ {path}.html /index.html
		file_server
	}
}

tsae.asia, www.tsae.asia {
	root * /var/www/tsae_web

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	# WP media (local wp-uploads/ — run ./deploy.sh uploads to sync)
	handle /wp-uploads/* {
		root * /var/www/tsae_web
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	handle /_astro/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.webp *.pdf *.docx
	handle @static {
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/ {path}.html /index.html
		file_server
	}
}
