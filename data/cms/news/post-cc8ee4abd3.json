e-231 alignnone\" src=\"https://www.tsae.asia/new/wp-uploads/2018/03/แข่งขัน_180329_0013-1024x577-300x169.jpg\" alt=\"\" width=\"300\" height=\"169\" /></a> <a href=\"https://www.tsae.asia/new/wp-uploads/2018/03/แข่งขัน_180329_0019-1024x577.jpg\"><img loading=\"lazy\" decoding=\"async\" class=\"size-medium wp-image-232 alignnone\" src=\"https://www.tsae.asia/new/wp-uploads/2018/03/แข่งขัน_180329_0019-1024x577-300x169.jpg\" alt=\"\" width=\"300\" height=\"169\" /></a> <a href=\"https://www.tsae.asia/new/wp-uploads/2018/03/แข่งขัน_180329_0020-1024x576.jpg\"><img loading=\"lazy\" decoding=\"async\" class=\"size-medium wp-image-233 alignnone\" src=\"https://www.tsae.asia/new/wp-uploads/2018/03/แข่งขัน_180329_0020-1024x576-300x169.jpg\" alt=\"\" width=\"300\" height=\"169\" /></a><a href=\"https://www.tsae.asia/new/wp-uploads/2018/03/แข่งขัน_180329_0003-1024x576.jpg\"><img loading=\"lazy\" decoding=\"async\" class=\"size-medium wp-image-234 alignnone\" src=\"https://www.tsae.asia/new/wp-uploads/2018/03/แข่งขัน_180329_0003-1024x576-300x169.jpg\" alt=\"\" width=\"300\" height=\"169\" /></a></p>\n<div style=\"margin: 20px 0;\">\n<div class=\"qrcswholewtapper\" style=\"text-align:left;\">\n<div class=\"qrcprowrapper\"  id=\"qrcwraa209leds\">\n<div class=\"qrc_canvass\" id=\"qrc_cuttenpages_209\" style=\"display:inline-block\" data-text=\"https://www.tsae.asia/%e0%b8%81%e0%b8%b2%e0%b8%a3%e0%b9%81%e0%b8%82%e0%b9%88%e0%b8%87%e0%b8%82%e0%b8%b1%e0%b8%99%e0%b8%97%e0%b8%b1%e0%b8%81%e0%b8%a9%e0%b8%b0%e0%b8%97%e0%b8%b2%e0%b8%87%e0%b8%a7%e0%b8%b4%e0%b8%a8%e0%b8%a7/\"></div>\n<div><a download=\"การแข่งขันทักษะทางวิศวกรรมเกษตร : การประกวดและแข่งขันหุ่นยนต์เก็บผลผลิตทางการเกษตร.png\" class=\"qrcdownloads\" id=\"worign\"><br />\n           <button type=\"button\" style=\"min-width:200px;background:#dddddd;color:#000;font-weight: 600;border: 1px solid #dddddd;border-radius:4px;font-size:12px;padding: 6px 0;\" class=\"uqr_code_btn\">QRCode 2 Me</button><br />\n           </a></div>\n</div>\